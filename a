            --======================== KEYBIND ===========================
            function Section:Keybind(cfg4)
                cfg4 = cfg4 or {}
                local key = cfg4.Value or cfg4.Default or "F"
                local mode = cfg4.Mode or (cfg4.Pressed and "Hold" or "Toggle")
                local cb = cfg4.Callback or function() end
                local onPressed = cfg4.Pressed or function() end
                local onReleased = cfg4.Released or function() end

                local r, entry = buildRow(38, cfg4.Title or "Keybind", {flag = cfg4.Flag, extra = mode})
                local x = iconSlot(r, cfg4.Icon)
                rowLabel(r, cfg4.Title or "Keybind", 11, x)

                local b = new("TextButton", {
                    Size = UDim2.new(0, 70, 0, 22), Position = UDim2.new(1, -80, 0.5, -11),
                    BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, Text = tostring(key),
                    TextColor3 = T.TEXT_SEC, TextSize = 10, Font = Enum.Font.GothamBold,
                    AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 6,
                }, r)
                corner(b, 5)
                local bs = stroke(b, T.BORDER, 1, 0.5)

                local listening, holdConn, releaseConn = false, nil, nil
                local held = false

                local function paint()
                    local active = listening or held
                    b.BackgroundColor3 = listening and T.CARD_HOVER or (held and T.ACCENT_FADE or T.PANEL)
                    b.TextColor3 = active and T.ACCENT or T.TEXT_SEC
                    bs.Color = active and T.ACCENT or T.BORDER
                    bs.Transparency = active and 0.1 or 0.5
                end
                local function stopListen()
                    listening = false
                    if holdConn then holdConn:Disconnect() ; holdConn = nil end
                    b.Text = tostring(key)
                    paint()
                end
                local function commit(k)
                    key = k
                    b.Text = tostring(key)
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = key end
                    if Window._scheduleAutosave then Window._scheduleAutosave() end
                    pcall(cb, key)
                end

                on(b.MouseButton1Click, function()
                    if listening then stopListen() return end
                    listening = true
                    b.Text = "..."
                    paint()
                    holdConn = UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        local isKey = input.UserInputType == Enum.UserInputType.Keyboard
                        local isMouse = input.UserInputType == Enum.UserInputType.MouseButton
                        if not (isKey or isMouse) then return end
                        if input.KeyCode == Enum.KeyCode.Escape then
                            stopListen()
                        elseif input.KeyCode == Enum.KeyCode.Backspace then
                            commit("None")
                            stopListen()
                        else
                            commit(input.KeyCode.Name)
                            stopListen()
                        end
                    end)
                    track(holdConn)
                end)

                if mode == "Hold" then
                    releaseConn = UIS.InputEnded:Connect(function(input)
                        if not input.KeyCode then return end
                        if input.KeyCode.Name == tostring(key) and held then
                            held = false
                            paint()
                            pcall(onReleased)
                        end
                    end)
                    track(releaseConn)
                end

                local triggerConn = UIS.InputBegan:Connect(function(input, gpe)
                    if gpe or listening or tostring(key) == "None" then return end
                    if not input.KeyCode or input.KeyCode.Name ~= tostring(key) then return end
                    if mode == "Hold" then
                        if not held then
                            held = true
                            paint()
                            pcall(onPressed)
                        end
                    else
                        held = true
                        paint()
                        pcall(onPressed)
                        task.delay(0.14, function()
                            held = false
                            paint()
                        end)
                    end
                end)
                track(triggerConn)

                local Keybind = {}
                local function set(k, silent)
                    key = k
                    b.Text = tostring(key)
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = key end
                    if not silent then pcall(cb, key) end
                    paint()
                end
                entry.set = function(k) set(k) end
                entry.get = function() return key end
                entry.reset = function(silent) set(cfg4.Default or cfg4.Value or "F", silent) end
                reg(entry, entry.set, entry.get, entry.reset, key)
                function Keybind:Set(k) set(k) end
                function Keybind:Get() return key end
                function Keybind:SetValue(k) set(k, true) end
                function Keybind:Reset() entry.reset() end
                function Keybind:IsListening() return listening end
                Keybind.Row = r
                R(function(T2)
                    bs.Color = (listening or held) and T2.ACCENT or T2.BORDER
                    b.TextColor3 = (listening or held) and T2.ACCENT or T2.TEXT_SEC
                end)
                paint()
                return Keybind
            end

