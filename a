    notifHolder = holder
    return holder
end

function Azura:Notify(cfg)
    cfg = cfg or {}
    local T = cfg.Theme or Azura._theme or palette("Purple")
    local title = cfg.Title or "Notification"
    local content = cfg.Content or ""
    local duration = cfg.Duration or 4

    local holder = getNotifHolder()

    local card = new("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundColor3 = T.Card,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Position = UDim2.new(0, 70, 0, 0),
    }, holder)
    corner(card, 12)
    stroke(card, T.Line, 1, 0.25)

    local bar = new("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    }, card)
    grad(bar, T.Accent, T.Accent2, 90)

    local logo = new("Frame", {
        Size = UDim2.fromOffset(34, 34),
        Position = UDim2.new(0, 14, 0, 13),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    }, card)
    corner(logo, 10)
    grad(logo, T.Accent, T.Accent2, 35)
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "U",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 17,
        Font = Enum.Font.GothamBold,
    }, logo)

    new("TextLabel", {
        Size = UDim2.new(1, -100, 0, 16),
        Position = UDim2.new(0, 58, 0, 13),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = T.Text,
        TextSize = 14,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local body = new("TextLabel", {
        Size = UDim2.new(1, -104, 0, 0),
        Position = UDim2.new(0, 58, 0, 31),
        BackgroundTransparency = 1,
        Text = content,
        TextColor3 = T.Text2,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, card)

    local close = new("TextButton", {
        Size = UDim2.fromOffset(22, 22),
        Position = UDim2.new(1, -32, 0, 12),
        BackgroundTransparency = 1,
        Text = "✕",
        TextColor3 = T.Text3,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        AutoButtonColor = false,
    }, card)
    close.MouseEnter:Connect(function() tween(close, {TextColor3 = T.Text}, 0.14) end)
    close.MouseLeave:Connect(function() tween(close, {TextColor3 = T.Text3}, 0.14) end)

    local progress = new("Frame", {
        Size = UDim2.new(1, 0, 0, 3),
        Position = UDim2.new(0, 0, 1, -3),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    }, card)
    grad(progress, T.Accent, T.Accent2, 90)

    task.defer(function()
        local h = math.clamp(26 + body.TextBounds.Y + 14, 74, 200)
        tween(card, {Size = UDim2.new(1, 0, 0, h), Position = UDim2.new(0, 0, 0, 0)}, 0.42,
            Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        tween(progress, {Size = UDim2.new(1, 0, 0, 3)}, 0.35)
    end)

    local dead = false
    local function kill()
        if dead then return end
        dead = true
        tween(card, {Position = UDim2.new(0, 70, 0, 0), BackgroundTransparency = 1}, 0.28).Completed:Connect(function()
            card:Destroy()
        end)
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") then tween(d, {TextTransparency = 1}, 0.2) end
            if d:IsA("Frame") then tween(d, {BackgroundTransparency = 1}, 0.2) end
        end
    end
    close.MouseButton1Click:Connect(kill)

    task.spawn(function()
        local steps = 40
        for i = 1, steps do
            if dead then return end
            if not card.Parent then return end
            progress.Size = UDim2.new(1 - (i / steps), 0, 0, 3)
            task.wait(math.max(0.02, (duration / steps)))
        end
        kill()
    end)

    return card
end

