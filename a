                createCorner(sliderBar, 3)
                
                local sliderFill = Instance.new("Frame")
                sliderFill.Size = UDim2.new((sDefault - sMin) / (sMax - sMin), 0, 1, 0)
                sliderFill.BackgroundColor3 = theme.Accent
                sliderFill.BorderSizePixel = 0
                sliderFill.Parent = sliderBar
                createCorner(sliderFill, 3)
                
                local sliderCircle = Instance.new("Frame")
                sliderCircle.Size = UDim2.new(0, 14, 0, 14)
                sliderCircle.Position = UDim2.new(1, -7, 0.5, -7)
                sliderCircle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
                sliderCircle.BorderSizePixel = 0
                sliderCircle.Parent = sliderFill
                createCorner(sliderCircle, 7)
                
                local dragging = false
                local value = sDefault
                
                local function updateSlider(input)
                    local pos = input and input.Position or nil
                    if not pos then return end
                    local relative = math.clamp((pos.X - sliderBar.AbsolutePosition.X) / sliderBar.AbsoluteSize.X, 0, 1)
                    value = math.floor((sMin + (sMax - sMin) * relative) / sStep) * sStep
                    value = math.clamp(value, sMin, sMax)
                    sliderFill.Size = UDim2.new(relative, 0, 1, 0)
                    sliderValue.Text = tostring(value)
                    pcall(sCallback, value)
                end
                
                sliderBar.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = true
                        updateSlider(input)
                    end
                end)
                
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        updateSlider(input)
                    end
                end)
                
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        dragging = false
                    end
                end)
                
                local Slider = {}
                function Slider:Set(v)
                    value = math.clamp(v, sMin, sMax)
                    local rel = (value - sMin) / (sMax - sMin)
                    sliderFill.Size = UDim2.new(rel, 0, 1, 0)
                    sliderValue.Text = tostring(value)
                    pcall(sCallback, value)
                end
                return Slider
            end
            
