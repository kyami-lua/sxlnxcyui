                    Text = "▾",
                    TextColor3 = T.Text3,
                    TextSize = 13,
                    Font = Enum.Font.GothamBold,
                    ZIndex = 6,
                }, head)

                local open = false

                local function updateText()
                    if multi then
                        if #selected == 0 then
                            valueLbl.Text = "None"
                        else
                            valueLbl.Text = table.concat(selected, ", ")
                        end
                    else
                        valueLbl.Text = tostring(selected)
                    end
                end

                local function isPicked(v)
                    if multi then
                        for _, s in ipairs(selected) do
                            if s == v then return true end
                        end
                        return false
                    end
                    return selected == v
                end

                local rows = {}
                local function refresh()
                    for _, item in ipairs(rows) do
                        local on = isPicked(item.value)
                        item.frame.BackgroundColor3 = on and T.Accent or T.Sunk
                        item.label.TextColor3 = on and Color3.fromRGB(255, 255, 255) or T.Text2
                    end
                end

                local options = new("Frame", {
                    Size = UDim2.new(1, -20, 0, 0),
                    Position = UDim2.new(0, 10, 0, 46),
                    BackgroundTransparency = 1,
                    ZIndex = 5,
                }, r)
                list(options, 3)

                for i, v in ipairs(values) do
                    local item = new("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        BackgroundColor3 = T.Sunk,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        ZIndex = 6,
                        LayoutOrder = i,
                    }, options)
                    corner(item, 7)
                    local lbl = new("TextLabel", {
                        Size = UDim2.new(1, -20, 1, 0),
                        Position = UDim2.new(0, 10, 0, 0),
                        BackgroundTransparency = 1,
                        Text = tostring(v),
                        TextColor3 = T.Text2,
                        TextSize = 12,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 7,
                    }, item)
                    table.insert(rows, {frame = item, label = lbl, value = v})

                    item.MouseButton1Click:Connect(function()
                        if multi then
                            local found
                            for idx, s in ipairs(selected) do
                                if s == v then found = idx end
                            end
                            if found then
                                table.remove(selected, found)
                            else
                                table.insert(selected, v)
                            end
                        else
                            selected = v
                            open = false
                            options.Visible = false
                            arrow.Text = "▾"
                            tween(r, {Size = UDim2.new(1, 0, 0, 40)}, 0.2)
                        end
                        updateText()
                        refresh()
                        pcall(cb, selected)
                    end)
                end

                local function toggle()
                    open = not open
                    options.Visible = open
                    arrow.Text = open and "▴" or "▾"
                    local h = 46 + (#values * 31) + 10
                    tween(r, {Size = UDim2.new(1, 0, 0, open and h or 40)}, 0.24, Enum.EasingStyle.Quart)
                end

                head.MouseEnter:Connect(function() tween(head, {BackgroundColor3 = T.RowHi}, 0.14) end)
                head.MouseLeave:Connect(function() tween(head, {BackgroundColor3 = T.Row}, 0.14) end)
                head.MouseButton1Click:Connect(toggle)

                local Dropdown = {}
                function Dropdown:Set(v)
                    selected = v
                    if multi and type(v) ~= "table" then selected = {v} end
                    updateText()
                    refresh()
                    pcall(cb, selected)
                end
                function Dropdown:Get() return selected end
                updateText()
                refresh()
                return Dropdown
            end

