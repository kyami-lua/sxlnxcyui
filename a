local function makeTooltip(scr, T)
    local tip = new("Frame", {
        Size = UDim2.fromOffset(0, 22), BackgroundColor3 = T.PANEL,
        BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false, ZIndex = 90,
    }, scr)
    corner(tip, 5)
    local bs = stroke(tip, T.BORDER, 1, 0.4)
    local lbl = new("TextLabel", {
        Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0),
        BackgroundTransparency = 1, Text = "", TextColor3 = T.TEXT_PRI, TextSize = 10,
        Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 91,
    }, tip)
    local shown = false
    local Tooltip = {}
    function Tooltip:Show(text, anchorX, anchorY)
        lbl.Text = text
        tip.Size = UDim2.fromOffset(math.min(280, #text * 5.4 + 18), 22)
        tip.Position = UDim2.fromOffset(anchorX, anchorY)
        if not shown then
            shown = true
            tip.Visible = true
            tip.Position = UDim2.fromOffset(anchorX, anchorY + 4)
            tw(tip, {BackgroundTransparency = 0.05, Position = UDim2.fromOffset(anchorX, anchorY)}, 0.14)
            tw(bs, {Transparency = 0.15}, 0.14)
        end
    end
    function Tooltip:Hide()
        if not shown then return end
        shown = false
        tw(tip, {BackgroundTransparency = 1}, 0.12)
        tw(bs, {Transparency = 1}, 0.12)
        task.delay(0.13, function() if not shown then tip.Visible = false end end)
    end
    function Tooltip:Repaint(T2)
        tip.BackgroundColor3 = T2.PANEL
        bs.Color = T2.BORDER
        lbl.TextColor3 = T2.TEXT_PRI
    end
    function Tooltip:Destroy() tip:Destroy() end
    return Tooltip
end

local function attachTip(obj, text, tooltip)
    if not tooltip or not text or text == "" then return end
    obj.MouseEnter:Connect(function()
        tooltip:Show(text, obj.AbsolutePosition.X, obj.AbsolutePosition.Y + obj.AbsoluteSize.Y + 6)
    end)
    obj.MouseLeave:Connect(function() tooltip:Hide() end)
end

