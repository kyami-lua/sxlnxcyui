            -- row factory: layout + search registry + right click menu
            local function buildRow(height, title, meta)
                local r, slot = Section._makeRow(height)
                local entry = {
                    row = slot, target = r, title = title, section = Section, tab = Tab,
                    search = string.lower(tostring(title or "") .. " " .. tostring(meta and meta.extra or "")
                        .. " " .. tostring(meta and meta.flag or "")),
                }
                if meta then
                    for k, v in pairs(meta) do entry[k] = v end
                end
                table.insert(entries, entry)
                table.insert(Tab._entries, entry)
                table.insert(Section.Rows, entry)
                if not grouped then
                    hover(r, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.CARD})
                end
                if entry.reset or entry.flag or entry.get then
                    on(slot.InputBegan, function(input)
                        if input.UserInputType == Enum.UserInputType.MouseButton2 then
                            local m = UIS:GetMouseLocation()
                            openContext(entry, m.X, m.Y)
                        end
                    end)
                end
                return r, entry
            end
            Section._buildRow = buildRow

            local function rowLabel(r, text, y, x)
                return new("TextLabel", {
                    Size = UDim2.new(0, 0, 0, 15), AutomaticSize = Enum.AutomaticSize.X,
                    Position = UDim2.new(0, x or 12, 0, y), BackgroundTransparency = 1, Text = text,
                    TextColor3 = T.TEXT_PRI, TextSize = 11, Font = Enum.Font.GothamBold,
