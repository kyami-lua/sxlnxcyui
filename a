local SKEL = {
    { "Head", "Torso" }, { "Torso", "Left Arm" }, { "Torso", "Right Arm" },
    { "Torso", "Left Leg" }, { "Torso", "Right Leg" },
    { "Torso", "HumanoidRootPart" },
}
local SKEL15 = {
    { "Head", "UpperTorso" }, { "UpperTorso", "LeftUpperArm" }, { "UpperTorso", "RightUpperArm" },
    { "UpperTorso", "LowerTorso" }, { "LowerTorso", "LeftUpperLeg" }, { "LowerTorso", "RightUpperLeg" },
    { "Head", "LowerTorso" },
}

local function limbPart(char, name)
    return char:FindFirstChild(name)
end

local function getColor(plr)
    if Visual.UseTeamColor and plr.Team and plr.Team.TeamColor then
        return plr.Team.TeamColor.Color
    end
    return Visual.BoxColor
end

local function drawESP(plr, e)
    local cam = Camera
    local char = plr.Character
    local scale = 1
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not isAlive(char) then
        for _, d in pairs(e.Drawing) do d.Visible = false end
        for _, ln in ipairs(e.skeletonLines) do ln.Visible = false end
        return
    end
    local hrp = getAimPart(char)
    if not hrp then return end
    local rootPos = hrp.Position
    local dist = (rootPos - cam.CFrame.Position).Magnitude
    if dist > Visual.MaxDist then
        for _, d in pairs(e.Drawing) do d.Visible = false end
        for _, ln in ipairs(e.skeletonLines) do ln.Visible = false end
        return
    end
    local head = char:FindFirstChild("Head")
    local topPos = (head and head.Position or (rootPos + Vector3.new(0, 3, 0)))
    local bottoms, tops = cam:WorldToViewportPoint(rootPos), cam:WorldToViewportPoint(topPos)
    local onScreen = bottoms.Z > 0 and tops.Z > 0
    if not onScreen then
        for _, d in pairs(e.Drawing) do d.Visible = false end
        for _, ln in ipairs(e.skeletonLines) do ln.Visible = false end
        return
    end
    local bh = math.abs(tops.Y - bottoms.Y)
    local bw = math.clamp(bh * 0.6, 8, 400)
    local bx = bottoms.X - bw / 2
    local by = math.min(tops.Y, bottoms.Y)
    local col = getColor(plr)
    if Visual.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team then
        for _, d in pairs(e.Drawing) do d.Visible = false end
        for _, ln in ipairs(e.skeletonLines) do ln.Visible = false end
        return
    end

    if Visual.Box then
        e.Drawing.box.Position = Vector2.new(bx, by)
        e.Drawing.box.Size = Vector2.new(bw, bh)
        e.Drawing.box.Color = col
        e.Drawing.box.Visible = true
    end

    if Visual.Name then
        e.Drawing.name.Position = Vector2.new(bx + bw / 2, by - 13)
        e.Drawing.name.Text = plr.Name
        e.Drawing.name.Color = Visual.UseTeamColor and col or Color3.fromRGB(255, 255, 255)
        e.Drawing.name.Visible = true
    end

    local hp, max = hum.Health, hum.MaxHealth
    local ratic = math.clamp(hp / max, 0, 1)
    local barW, barH = bw, 2.5
    if Visual.Healthbar then
        e.Drawing.hpbg.From = Vector2.new(bx, by - 4)
        e.Drawing.hpbg.To = Vector2.new(bx + barW, by - 4)
        e.Drawing.hpbg.Color = Color3.fromRGB(0, 0, 0)
        e.Drawing.hpbg.Thickness = barH + 0.5
        e.Drawing.hpbg.Visible = true
        local fcol = ratic > 0.5 and Color3.fromRGB(60, 220, 90) or (ratic > 0.25 and Color3.fromRGB(245, 190, 60) or Color3.fromRGB(235, 60, 60))
        e.Drawing.healthbar.From = Vector2.new(bx, by - 4)
        e.Drawing.healthbar.To = Vector2.new(bx + barW * ratic, by - 4)
        e.Drawing.healthbar.Color = fcol
        e.Drawing.healthbar.Thickness = barH
        e.Drawing.healthbar.Visible = true
    end
    if Visual.Healthtext then
        e.Drawing.healthtext.Position = Vector2.new(bx + bw / 2, by + bh - 16)
        e.Drawing.healthtext.Text = tostring(math.floor(hp))
        e.Drawing.healthtext.Color = ratic > 0.5 and Color3.fromRGB(60, 220, 90) or (ratic > 0.25 and Color3.fromRGB(245, 190, 60) or Color3.fromRGB(235, 60, 60))
        e.Drawing.healthtext.Visible = true
    end
    if Visual.Distance then
        e.Drawing.distance.Position = Vector2.new(bx + bw / 2, by + bh + 2)
        e.Drawing.distance.Text = tostring(math.floor(dist)) .. " studs"
        e.Drawing.distance.Color = Color3.fromRGB(255, 255, 255)
        e.Drawing.distance.Visible = true
    end
    local tool = char:FindFirstChildOfClass("Tool")
    if Visual.Weapon then
        e.Drawing.weapon.Position = Vector2.new(bx + bw / 2, by + bh + 14)
        e.Drawing.weapon.Text = tool and tool.Name or "None"
        e.Drawing.weapon.Color = Color3.fromRGB(190, 190, 200)
        e.Drawing.weapon.Visible = true
    end
    if Visual.Tracer then
        e.Drawing.tracer.From = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y)
        e.Drawing.tracer.To = Vector2.new(bottoms.X, bottoms.Y)
        e.Drawing.tracer.Color = col
        e.Drawing.tracer.Transparency = 0.7
        e.Drawing.tracer.Visible = true
    end
    if Visual.Circular then
        e.Drawing.circle.Position = Vector2.new(bottoms.X, bottoms.Y)
        e.Drawing.circle.Radius = math.clamp(bh * 0.75, 10, 80)
        e.Drawing.circle.Color = col
        e.Drawing.circle.Visible = true
    end

    -- skeleton
    for _, ln in ipairs(e.skeletonLines) do ln.Visible = false end
    if Visual.Skeleton then
        local bones
        local useR6 = char:FindFirstChild("Torso") ~= nil
        bones = useR6 and SKEL or SKEL15
        local idx = 0
        local a = e.skeletonLines
        for i, pair in ipairs(bones) do
            local p1, p2 = limbPart(char, pair[1]), limbPart(char, pair[2])
            if p1 and p2 then
                local s1 = cam:WorldToViewportPoint(p1.Position)
                local s2 = cam:WorldToViewportPoint(p2.Position)
                if s1.Z > 0 and s2.Z > 0 then
                    idx = idx + 1
                    local ln = a[idx]
                    if ln then
                        ln.From = Vector2.new(s1.X, s1.Y)
                        ln.To = Vector2.new(s2.X, s2.Y)
                        ln.Color = col
                        ln.Visible = true
                    end
                end
            end
        end
    end
end

