local function shade(c, f)
    return Color3.fromRGB(
        math.clamp(math.floor(c.R * 255 * f), 0, 255),
        math.clamp(math.floor(c.G * 255 * f), 0, 255),
        math.clamp(math.floor(c.B * 255 * f), 0, 255))
end

local function palette(accent)
    local a = Azura.Accents[accent] or Azura.Accents.Red
    return {
        BG          = Color3.fromRGB(8, 8, 10),
        SURFACE     = Color3.fromRGB(13, 13, 16),
        PANEL       = Color3.fromRGB(18, 18, 22),
        CARD        = Color3.fromRGB(24, 24, 29),
        CARD_HOVER  = Color3.fromRGB(30, 30, 36),
        GRADIENT_TOP= Color3.fromRGB(20, 20, 26),
        ACCENT      = a[1],
        ACCENT_DIM  = shade(a[1], 0.5),
        ACCENT_GLOW = a[2],
        TEXT_PRI    = Color3.fromRGB(245, 245, 250),
