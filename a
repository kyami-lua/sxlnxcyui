        return Stats.Network:GetPing()
    end) or 0
end
function Misc.Copy(text)
    local ok = safe(function()
        setclipboard(tostring(text))
    end)
    return ok ~= nil
end
function Misc.Kick(plr, reason)
    reason = reason or "Kicked by Ugly Hub"
    if not plr or plr == LocalPlayer then
        pcall(function() game:GetService("Players").LocalPlayer:Kick(reason) end)
        return true
    end
    -- best-effort server kick via any remote that looks like a kick
    return safe(function()
        local RS = game:GetService("ReplicatedStorage")
        for _, obj in ipairs(RS:GetDescendants()) do
            if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and
                tostring(obj.Name):lower():find("kick") then
                if obj:IsA("RemoteEvent") then
                    obj:FireServer(plr, reason)
                else
                    obj:InvokeServer(plr, reason)
                end
                return true
            end
        end
        return false
    end) or false
end

