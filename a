    end)

    return Win, Ugly
end

-- auto-build unless flagged otherwise
if not getgenv().UglyHub_Silent then
    local ok, err = pcall(Ugly.BuildHub, getgenv().UglyHubBuild or {})
    if not ok then
        local es = tostring(err)
        getgenv().UglyHubLastError = es
        warn("[UglyHub] build failed: " .. es)
        pcall(function()
            local lp = game:GetService("Players").LocalPlayer
            local pg = lp and lp:FindFirstChild("PlayerGui")
            if pg then
                local sg = Instance.new("ScreenGui", pg)
                local l = Instance.new("TextLabel", sg)
                l.Size = UDim2.fromScale(1, 0.08)
                l.Position = UDim2.fromScale(0, 0)
                l.BackgroundColor3 = Color3.fromRGB(220, 0, 0)
                l.TextColor3 = Color3.new(1, 1, 1)
                l.TextScaled = true
                l.ZIndex = 999
                l.Text = "[UglyHub] " .. es
            end
        end)
    end
end

return Ugly
