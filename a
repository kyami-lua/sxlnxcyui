                }, r)
                corner(holder, 5)
                hover(holder, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.CARD})

                local head = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, Text = "",
                    AutoButtonColor = false, ZIndex = 9,
                }, holder)

