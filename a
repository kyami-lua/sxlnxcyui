            function Section:Dropdown(cfg4)
                cfg4 = cfg4 or {}
                local options = cfg4.Values or cfg4.Options or {"Option 1", "Option 2"}
                local multi = cfg4.Multi and true or false
                local selected
                if multi then
                    selected = cfg4.Default or cfg4.Value or {}
                    if type(selected) ~= "table" then selected = {selected} end
                else
                    selected = cfg4.Default or cfg4.Value or options[1]
                end
                local cb = cfg4.Callback or function() end

                local r = buildRow(38, cfg4.Title or "Dropdown")
                local x = iconSlot(r, cfg4.Icon)
                rowLabel(r, cfg4.Title or "Dropdown", 11, x)
                local valueLbl = new("TextLabel", {
                    Size = UDim2.new(0, 90, 0, 12),
                    Position = UDim2.new(1, -56, 0, 12),
                    BackgroundTransparency = 1,
                    Text = "",
