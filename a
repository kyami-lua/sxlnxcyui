                    if Section.Grouped then Section._sizeCard() end
                    holder.Size = UDim2.new(1, 0, 0, h)
                    r.Size = UDim2.new(1, 0, 0, h)
                end
                local function expand()
                    open = true
                    tw(chev, {Rotation = 180}, 0.18, Enum.EasingStyle.Quart)
                    if scrolls then listParent.Size = UDim2.new(1, 0, 0, listH) end
                    if perf then
                        sizeRows(38 + listH)
                    else
                        tw(holder, {Size = UDim2.new(1, 0, 0, 38 + listH)}, 0.2, Enum.EasingStyle.Quart)
                        tw(r, {Size = UDim2.new(1, 0, 0, 38 + listH)}, 0.2, Enum.EasingStyle.Quart)
                        if Section.Grouped then Section._sizeCard() end
                    end
                end
                local function close()
                    open = false
                    tw(chev, {Rotation = 0}, 0.16, Enum.EasingStyle.Quart)
                    if scrolls then listParent.Size = UDim2.new(1, 0, 0, 0) end
                    tw(holder, {Size = UDim2.new(1, 0, 0, 38)}, 0.18, Enum.EasingStyle.Quart)
                    tw(r, {Size = UDim2.new(1, 0, 0, 38)}, 0.18, Enum.EasingStyle.Quart)
                    if Section.Grouped then Section._sizeCard() end
                end

