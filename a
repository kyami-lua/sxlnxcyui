function Aimbot:GetCamera()
    if Camera and Camera.Parent then return Camera end
    Camera = Workspace:FindFirstChildOfClass("Camera") or workspace.CurrentCamera
    return Camera
end
function Aimbot:WorldToViewportPoint(p) return self:GetCamera():WorldToViewportPoint(p) end
function Aimbot:Raycast(origin, dir, filterInstances)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = filterInstances or { LocalPlayer.Character, self:GetCamera() }
    return Workspace:Raycast(origin, dir, params), params
end
function Aimbot:RaycastParams(filterInstances, filterType)
    local params = RaycastParams.new()
    params.FilterType = filterType or Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = filterInstances or {}
    return params
end
function Aimbot:GetPartBoundsInRadius(pos, radius)
    return Workspace:GetPartBoundsInRadius(pos, radius)
end
function Aimbot:GetPlayers()
    return Players:GetPlayers()
end
function Aimbot:GetPlayerFromCharacter(obj)
    if obj and obj.Parent and Players:GetPlayerFromCharacter(obj.Parent) then
        return Players:GetPlayerFromCharacter(obj.Parent)
    end
    local n = obj
    while n do
        local plr = (n.Parent and n.Parent:IsA("Model")) and Players:GetPlayerFromCharacter(n.Parent) or nil
        if plr then return plr end
        n = n.Parent
    end
    return nil
end

local function isAlive(char)
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum and hum.Health > 0
end
local function getAimPart(char)
    return char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart or char:FindFirstChild("Head")
end
local function isValidTarget(plr)
    if plr == LocalPlayer then return false end
    if Aimbot.TeamCheck and plr.Team and plr.Team == LocalPlayer.Team then return false end
    return true
end
local function visCheck(char, worldPos)
    if not Aimbot.VisCheck then return true end
    local cam = Aimbot:GetCamera()
    local origin = cam.CFrame.Position
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { LocalPlayer.Character, cam }
    local res = Workspace:Raycast(origin, (worldPos - origin).Unit * (worldPos - origin).Magnitude, params)
    if res and res.Instance then return res.Instance:IsDescendantOf(char) end
    return true
end

function Aimbot:GetClosest()
    local cam = Aimbot:GetCamera()
    local center = cam.ViewportSize / 2
    local best, bestScreen, bestDist = nil, nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if isValidTarget(plr) then
            local char, part = plr.Character, nil
            if char then part = getAimPart(char) end
            if part and isAlive(char) then
                local aimPos = part.Position + Vector3.new(0, Aimbot.YOffset, 0)
                local pos, on = cam:WorldToViewportPoint(aimPos)
                if on then
                    local sd = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                    if sd <= Aimbot.FOV then
                        local vis = visCheck(char, aimPos)
                        if vis then
                            local d3 = (part.Position - cam.CFrame.Position).Magnitude
                            if d3 < bestDist then
                                best, bestScreen, bestDist = plr, pos, d3
                            end
                        end
                    end
                end
            end
        end
    end
    return best, bestScreen, bestDist
end

function Aimbot:AimKeyPressed()
    return not Aimbot.Hold or (Aimbot.Hold and Input.IsKeyDown(Aimbot.Key))
end

function Aimbot:Lock(plr)
    if not plr then return false end
    Aimbot._target = plr
    Aimbot._locked = plr
    Aimbot.Hold = true
    return true
end
function Aimbot:Unlock()
    Aimbot._target = nil
    Aimbot._locked = nil
    Aimbot.Hold = false
end

function Aimbot:SilentTarget(plr)
    Aimbot._silentTarget = plr
end

function Aimbot:GetAimHit()
    if Aimbot._silentTarget then
        local char = Aimbot._silentTarget.Character
        local part = char and getAimPart(char)
        if part then
            local cam = Aimbot:GetCamera()
            return CFrame.lookAt(cam.CFrame.Position, part.Position + Vector3.new(0, Aimbot.YOffset, 0))
        end
    end
    return nil
end

function Aimbot:Shoot()
    local char, tool = LocalPlayer.Character, nil
    if char then tool = char:FindFirstChildOfClass("Tool") end
    if not tool then return false end
    local hit = Aimbot:GetAimHit()
    if hit then
        Aimbot._shootHit = hit
    end
    pcall(function()
        if tool:FindFirstChildOfClass("Humanoid") then return end
        tool:Activate()
    end)
    return true
end

-- silent-aim: intercept mouse.Hit reads while a silent target is held
if not getgenv().UglyHub_SilentHooked then
    getgenv().UglyHub_SilentHooked = true
    local ok, mouse = pcall(function() return LocalPlayer:GetMouse() end)
    if ok and mouse and getrawmetatable then
        local mt = pcall(function() return getrawmetatable(mouse) end)
        if type(mt) == "table" then
            local oldIndex = mt.__index
            mt.__index = newcclosure(function(self, k)
                local aim = getgenv().UglyHub
                local ab = aim and aim.aimbot
                if k == "Hit" and ab and ab._silentTarget and ab.Silent then
                    local h = ab:GetAimHit()
                    if h then return h end
                end
                if type(oldIndex) == "function" then
                    return oldIndex(self, k)
                end
                return oldIndex[k]
            end)
        end
    end
end

-- renders + targeting loop
local aimLoop
aimLoop = RunService.RenderStepped:Connect(function()
    if getgenv().UglyHub_Session ~= SESSION then return end
    if not Aimbot.Enabled then
        if fovDraw then fovDraw.Visible = false end
        if targetDraw then targetDraw.Visible = false end
        return
    end
    local cam = Aimbot:GetCamera()

    if Aimbot.DrawFOV and fovDraw then
        fovDraw.Position = cam.ViewportSize / 2
        fovDraw.Radius = Aimbot.FOV
        fovDraw.Visible = true
    elseif fovDraw then
        fovDraw.Visible = false
    end

    local active = Aimbot.Rage or Aimbot:AimKeyPressed()

    if active and Aimbot.Enabled then
        local target = Aimbot._target
        local valid = false
        if target then
            local char = target.Character
            local part = char and getAimPart(char)
            if part and isAlive(char) and isValidTarget(target) then
                local aimPos = part.Position + Vector3.new(0, Aimbot.YOffset, 0)
                local pos, on = cam:WorldToViewportPoint(aimPos)
                if on and visCheck(char, aimPos) then
                    valid = true
                elseif on and Aimbot.Rage then
                    valid = true
                end
            end
        end
        if not valid then
            if Aimbot.AutoSwitch or not target then
                target = Aimbot:GetClosest()
            else
                target = nil
            end
            Aimbot._target = target
        end

        if target then
            local char = target.Character
            local part = char and getAimPart(char)
            if part then
                local aimPos = part.Position + Vector3.new(0, Aimbot.YOffset, 0)
                local targetCF = CFrame.lookAt(cam.CFrame.Position, aimPos)
                if Aimbot.Rage then
                    cam.CFrame = targetCF
                else
                    cam.CFrame = cam.CFrame:Lerp(targetCF, Aimbot.Smoothness)
                end
                if Aimbot.DrawTarget and targetDraw then
                    local pos = cam:WorldToViewportPoint(aimPos)
                    if pos.Z > 0 then
                        targetDraw.Position = Vector2.new(pos.X, pos.Y)
                        targetDraw.Radius = math.clamp(400 / pos.Z, 6, 30)
                        targetDraw.Visible = true
                        targetDraw.Color = Color3.fromRGB(255, 60, 60)
                    end
                end
            end
        end
    else
        Aimbot._target = nil
        if targetDraw then targetDraw.Visible = false end
    end

    -- lock-on stickiness reset
    if Aimbot.Rage then Aimbot.Hold = true end
end)

Aimbot.Loop = aimLoop

-- keybind-driven hold
UIS.InputBegan:Connect(function(input, gpe)
    if getgenv().UglyHub_Session ~= SESSION then return end
    if gpe then return end
    if input.KeyCode == Aimbot.Key and Aimbot.Enabled then
        Aimbot.Hold = true
        Aimbot._target = Aimbot:GetClosest()
    end
end)
UIS.InputEnded:Connect(function(input)
    if getgenv().UglyHub_Session ~= SESSION then return end
    if input.KeyCode == Aimbot.Key then
        Aimbot.Hold = false
        Aimbot._target = nil
    end
end)

