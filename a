                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                }, r)

                local box = new("TextBox", {
                    Size = UDim2.fromOffset(52, 20),
                    Position = UDim2.new(1, -64, 0, 6),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Text = tostring(value),
                    TextColor3 = T.Text,
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,
                    ClearTextOnFocus = false,
                    ZIndex = 5,
                }, r)
                corner(box, 6)
                stroke(box, T.Line, 1, 0.4)

                local track = new("Frame", {
                    Size = UDim2.new(1, -24, 0, 6),
                    Position = UDim2.new(0, 12, 0, 34),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    ZIndex = 5,
                }, r)
                corner(track, 3)
                local hit = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 24),
                    Position = UDim2.new(0, 0, 0.5, -12),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 9,
                }, track)

                local fill = new("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = T.Accent,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                }, track)
                corner(fill, 3)
                grad(fill, T.Accent, T.Accent2, 0)

                local knob = new("Frame", {
                    Size = UDim2.fromOffset(14, 14),
                    Position = UDim2.new(1, -7, 0.5, -7),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }, fill)
                corner(knob, 7)
                stroke(knob, Color3.fromRGB(0, 0, 0), 1, 0.8)

                local Slider = {}
                local dragging = false

                local function fmt(v)
                    if digits <= 0 then return tostring(math.floor(v + 0.5)) end
                    return string.format("%." .. digits .. "f", v)
                end

                local function set(v, silent)
                    v = math.clamp(tonumber(v) or min, min, max)
                    if step and step > 0 then
                        v = math.floor((v - min) / step + 0.5) * step + min
                        v = math.clamp(v, min, max)
                    end
                    value = v
                    local rel = (max - min == 0) and 0 or (v - min) / (max - min)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    box.Text = fmt(v)
                    if not silent then pcall(cb, v) end
                end

                local function fromX(x)
                    local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    set(min + (max - min) * rel)
                end

                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        fromX(input.Position.X)
                        tween(knob, {Size = UDim2.fromOffset(17, 17), Position = UDim2.new(1, -8.5, 0.5, -8.5)}, 0.12)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                        fromX(input.Position.X)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                        dragging = false
                        tween(knob, {Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -7, 0.5, -7)}, 0.14)
                    end
                end)

                box.FocusLost:Connect(function(enter)
                    if enter then set(box.Text) else box.Text = fmt(value) end
                end)

                function Slider:Set(v) set(v) end
                function Slider:Get() return value end
                set(value, true)
                return Slider
            end

