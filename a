local function gradientText() end

local function hardenSection(sec)
    if sec.__hardened then return sec end
    sec.__hardened = true

    local FACTORIES = {
        Toggle = { enh = true, kinds = { "Toggle" } },
        Slider = { enh = true },
        Dropdown = { enh = true },
        Button = { enh = true },
        Input = { enh = true },
        Textbox = { enh = true },
        Keybind = { enh = true },
        Colorpicker = { enh = true },
        Segment = { enh = true },
        Stepper = { enh = true },
        Progress = { enh = true, kinds = { "Progress", "SetLabel" } },
        Checkboxes = { enh = true, kinds = { "Checkboxes", "SetValue" } },
        Radio = { enh = true, kinds = { "Radio", "SetValue" } },
        Paragraph = { enh = true },
        Label = { enh = true },
    }

    for name, spec in pairs(FACTORIES) do
        local orig = sec[name]
        if orig then
            sec[name] = function(self, cfg4)
                local obj = orig(self, cfg4)
                if spec.enh then obj = enhanceElement(obj, cfg4, name) end
                return obj
            end
        end
    end

    -- aliases
    sec.Toggles = sec.Toggle
    sec.Options = sec.Dropdown
    sec.Group   = sec.Section or sec
    local parentFrame = sec.Frame

    -- Tag: small pill row
    function sec.Tag(cfg4)
        cfg4 = cfg4 or {}
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(0, 0, 0, 18)
        frame.BackgroundColor3 = cfg4.Color or Color3.fromRGB(24, 24, 29)
        frame.BorderSizePixel = 0
        frame.AutomaticSize = Enum.AutomaticSize.X
        frame.Parent = parentFrame
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0, 5)
        corner.Parent = frame
        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -14, 1, 0)
        label.Position = UDim2.new(0, 7, 0, 0)
        label.BackgroundTransparency = 1
        label.Text = tostring(cfg4.Title or cfg4.Text or "")
        label.TextColor3 = cfg4.TextColor or Color3.fromRGB(245, 245, 250)
        label.TextSize = 9
        label.Font = Enum.Font.GothamBold
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.Parent = frame
        local Tag = {}
        function Tag:Set(t) label.Text = tostring(t) end
        function Tag:Get() return label.Text end
        return Tag
    end

    -- Space: vertical gap
    function sec.Space(h)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, h or 8)
        frame.BackgroundTransparency = 1
        frame.SecurityCapabilities = nil
        frame.Parent = parentFrame
        return frame
    end

    return sec
end

