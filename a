            --========================= SLIDER ==========================
            function Section:Slider(cfg4)
                cfg4 = cfg4 or {}
                local min = (cfg4.Value and cfg4.Value.Min) or cfg4.Min or 0
                local max = (cfg4.Value and cfg4.Value.Max) or cfg4.Max or 100
                local value = (cfg4.Value and cfg4.Value.Default) or cfg4.Default or min
                local step = cfg4.Step or 1
                local decimals = cfg4.Decimals
                if decimals == nil then decimals = (step % 1 ~= 0) and 1 or 0 end
                local cb = cfg4.Callback or function() end

                local r = makeRow(46)
                new("TextLabel", {
                    Size = UDim2.new(1, -130, 0, 16),
                    Position = UDim2.new(0, 12, 0, 7),
                    BackgroundTransparency = 1,
                    Text = cfg4.Title or "Slider",
                    TextColor3 = T.Text,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)

                local box = new("TextBox", {
                    Size = UDim2.fromOffset(46, 18),
                    Position = UDim2.new(1, -58, 0, 6),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Text = tostring(value),
                    TextColor3 = T.Text2,
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    ClearTextOnFocus = false,
                    ZIndex = 6,
                }, r)
                corner(box, 5)
                stroke(box, T.Line, 1, 0.4)

                local track = new("Frame", {
                    Size = UDim2.new(1, -24, 0, 4),
                    Position = UDim2.new(0, 12, 0, 32),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                }, r)
                corner(track, 2)

                local hit = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0.5, -11),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 9,
                }, track)

                local fill = new("Frame", {
                    Size = UDim2.new(0, 0, 1, 0),
                    BackgroundColor3 = T.Accent,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }, track)
                corner(fill, 2)
                grad(fill, T.Accent, T.Accent2, 0)

                local knob = new("Frame", {
                    Size = UDim2.fromOffset(10, 10),
                    Position = UDim2.new(1, -5, 0.5, -5),
                    BackgroundColor3 = Color3.fromRGB(255, 255, 255),
                    BorderSizePixel = 0,
                    ZIndex = 8,
                }, fill)
                corner(knob, 5)

                local Slider = {}
                local dragging = false

                local function fmt(v)
                    if decimals <= 0 then return tostring(math.floor(v + 0.5)) end
                    return string.format("%." .. decimals .. "f", v)
                end

                local function set(v, silent)
                    v = math.clamp(tonumber(v) or min, min, max)
                    if step and step > 0 then
                        v = math.floor((v - min) / step + 0.5) * step + min
                        v = math.clamp(v, min, max)
                    end
                    value = v
                    local rel = (max - min == 0) and 0 or (v - min) / (max - min)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    box.Text = fmt(v)
                    if not silent then pcall(cb, v) end
                end

                local function fromX(x)
                    local rel = math.clamp((x - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    set(min + (max - min) * rel)
                end

                hit.InputBegan:Connect(function(input)
                    local t = input.UserInputType
                    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
                        dragging = true
                        fromX(input.Position.X)
                        tween(knob, {Size = UDim2.fromOffset(13, 13), Position = UDim2.new(1, -6.5, 0.5, -6.5)}, 0.1)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if not dragging then return end
                    local t = input.UserInputType
                    if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch then
                        fromX(input.Position.X)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    local t = input.UserInputType
                    if dragging and (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch) then
                        dragging = false
                        tween(knob, {Size = UDim2.fromOffset(10, 10), Position = UDim2.new(1, -5, 0.5, -5)}, 0.12)
                    end
                end)

                box.FocusLost:Connect(function(enter)
                    if enter then set(box.Text) else box.Text = fmt(value) end
                end)

                function Slider:Set(v) set(v) end
                function Slider:Get() return value end
                set(value, true)
                return Slider
            end

