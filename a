    local HS = game:GetService("HttpService")
    local function encode()
        local ok, s = pcall(function() return HS:JSONEncode(Window.Flags) end)
        return ok and s or nil
    end
    local configFile = cfg.ConfigFile or "UglyHub_Config.json"

    function Window:ExportString()
        local s = encode()
        if not s then return "" end
        pcall(function() setclipboard(s) end)
        return s
    end
    function Window:ImportString(s)
        local ok, data = pcall(function() return HS:JSONDecode(s) end)
        if not ok or type(data) ~= "table" then return false end
        for flag, value in pairs(data) do
            if setters[flag] then pcall(setters[flag], value) end
        end
        Window:Notify({Title = "Imported", Content = "settings applied from string", Icon = "code", Duration = 2})
        return true
    end
    function Window:SaveConfig(filename)
        filename = filename or configFile
        if not writefile then return false end
        local s = encode()
        if not s then return false end
        local ok = pcall(function() writefile(filename, s) end)
        return ok
    end
    function Window:LoadConfig(filename)
        filename = filename or configFile
        if not (isfile and readfile) then return false end
        local ok, data = pcall(function()
            if not isfile(filename) then return nil end
            return HS:JSONDecode(readfile(filename))
        end)
        if not ok or type(data) ~= "table" then return false end
        Window._lastLoaded = data
        for flag, value in pairs(data) do
            if setters[flag] then pcall(setters[flag], value) end
        end
        return true
    end
    function Window:SavePreset(name, notify)
        name = tostring(name or "preset"):gsub("[^%w_%-]", "")
        if name == "" then return false end
        local ok = Window:SaveConfig("UglyHub_" .. name .. ".json")
        if ok and notify then
            Window:Notify({Title = "Preset saved", Content = name, Icon = "flag", Duration = 2})
        end
        return ok
    end
    function Window:LoadPreset(name)
        name = tostring(name or "preset"):gsub("[^%w_%-]", "")
        local ok = Window:LoadConfig("UglyHub_" .. name .. ".json")
        if ok then
            Window:Notify({Title = "Preset loaded", Content = name, Icon = "layers", Duration = 2})
        end
        return ok
    end
    function Window:ListPresets()
        local out = {}
        if not (listfiles and isfile) then return out end
        pcall(function()
            for _, f in ipairs(listfiles()) do
                local name = tostring(f):match("UglyHub_(.-)%.json$")
                if name and name ~= "Config" then table.insert(out, name) end
            end
        end)
        return out
    end

