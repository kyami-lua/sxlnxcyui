                local key = cfg4.Value or "F"
                local cb = cfg4.Callback or function() end
                local pressed = cfg4.Pressed

                local r = row(40)

                new("TextLabel", {
                    Size = UDim2.new(1, -96, 1, 0),
                    Position = UDim2.new(0, 12, 0, 0),
                    BackgroundTransparency = 1,
                    Text = label,
                    TextColor3 = T.Text,
                    TextSize = 13,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                }, r)

                local b = new("TextButton", {
                    Size = UDim2.fromOffset(62, 22),
                    Position = UDim2.new(1, -74, 0.5, -11),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Text = key,
                    TextColor3 = T.Text2,
                    TextSize = 11,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                    ZIndex = 5,
                }, r)
                corner(b, 7)
                local bStroke = stroke(b, T.Line, 1, 0.4)

                local listening = false
                local conn

                local function stopListen()
                    listening = false
                    if conn then conn:Disconnect() ; conn = nil end
                    bStroke.Color = T.Line
                    bStroke.Transparency = 0.4
                    b.BackgroundColor3 = T.Sunk
                end

                b.MouseButton1Click:Connect(function()
                    if listening then stopListen() ; b.Text = key ; return end
                    listening = true
                    b.Text = "..."
                    bStroke.Color = T.Accent
                    bStroke.Transparency = 0
                    b.BackgroundColor3 = T.RowHi
                    conn = UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.UserInputType == Enum.UserInputType.Keyboard then
                            if input.KeyCode == Enum.KeyCode.Escape then
                                b.Text = key
                            elseif input.KeyCode == Enum.KeyCode.Backspace then
                                key = "None"
                                b.Text = key
                                pcall(cb, key)
                            else
                                key = input.KeyCode.Name
                                b.Text = key
                                pcall(cb, key)
                            end
                            stopListen()
                        end
                    end)
                end)

                if pressed then
                    UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == key then
                            pcall(pressed)
                        end
                    end)
                end

                local Keybind = {}
                function Keybind:Set(k)
                    key = k
                    b.Text = k
                    pcall(cb, k)
                end
                function Keybind:Get() return key end
                return Keybind
            end

            function Section:Paragraph(cfg4)
                cfg4 = cfg4 or {}
                local label = cfg4.Title or "Info"
                local desc = cfg4.Desc or ""

                local lines = math.max(1, math.ceil(#desc / 46))
                local h = 22 + lines * 15

                local r = new("Frame", {
                    Size = UDim2.new(1, 0, 0, desc == "" and 30 or h),
                    BackgroundColor3 = T.Row,
                    BorderSizePixel = 0,
                    ZIndex = 4,
                }, body)
                corner(r, 10)
                stroke(r, T.Line, 1, 0.5)

                new("TextLabel", {
                    Size = UDim2.new(1, -24, 0, 18),
                    Position = UDim2.new(0, 12, 0, 7),
                    BackgroundTransparency = 1,
                    Text = label,
                    TextColor3 = T.Text,
                    TextSize = 13,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                }, r)

                if desc ~= "" then
                    new("TextLabel", {
                        Size = UDim2.new(1, -24, 0, lines * 15),
                        Position = UDim2.new(0, 12, 0, 23),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextColor3 = T.Text3,
                        TextSize = 11,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top,
                        TextWrapped = true,
                        ZIndex = 5,
                    }, r)
                end

                return r
            end

            function Section:Divider()
                local d = new("Frame", {
                    Size = UDim2.new(1, -16, 0, 1),
                    Position = UDim2.new(0, 8, 0, 0),
                    BackgroundColor3 = T.Line,
                    BackgroundTransparency = 0.35,
                    BorderSizePixel = 0,
                    ZIndex = 4,
                }, body)
                return d
            end

            function Section:Label(text, desc)
                local r = row(desc and 46 or 30)
                new("TextLabel", {
                    Size = UDim2.new(1, -24, 0, 18),
                    Position = UDim2.new(0, 12, 0, desc and 6 or 6),
                    BackgroundTransparency = 1,
                    Text = text or "",
                    TextColor3 = T.Text2,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 5,
                }, r)
                if desc then
                    new("TextLabel", {
                        Size = UDim2.new(1, -24, 0, 14),
                        Position = UDim2.new(0, 12, 0, 25),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextColor3 = T.Text3,
                        TextSize = 11,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 5,
                    }, r)
                end
                return r
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        if #Window.Tabs == 1 then
            Tab:Select()
        end

        return Tab
    end

    --============================== INTRO ================================
    task.defer(function()
        main.Size = UDim2.new(0, 0, 0, 0)
        tween(main, {Size = UDim2.new(0, width, 0, height)}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        tween(halo, {BackgroundTransparency = 0.9}, 0.6)
    end)

    return Window
end

--==================================== ALIASES ======================================
Azura.Create = Azura.CreateWindow
Azura.new = Azura.CreateWindow

return Azura
