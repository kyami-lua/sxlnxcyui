--================================ PRIMITIVES ==================================
local function new(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            o[k] = v
        end
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(o, r)
    return new("UICorner", {CornerRadius = UDim.new(0, r or 6)}, o)
end

local function stroke(o, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end

local function pad(o, top, right, bottom, left)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft = UDim.new(0, left or 0),
    }, o)
end

local function vlist(o, gap)
    return new("UIListLayout", {
        Padding = UDim.new(0, gap or 0),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
    }, o)
end

local function grad(o, c1, c2, rot)
    return new("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 0}, o)
end

local function tw(o, props, time, style, dir)
    local t = TS:Create(o, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function hover(obj, on, off)
    obj.MouseEnter:Connect(function() tw(obj, on, 0.12) end)
    obj.MouseLeave:Connect(function() tw(obj, off, 0.14) end)
end

local function lerpColor(a, b, t)
    return Color3.fromRGB(
        math.floor(a.R * 255 + (b.R - a.R) * 255 * t),
        math.floor(a.G * 255 + (b.G - a.G) * 255 * t),
        math.floor(a.B * 255 + (b.B - a.B) * 255 * t))
end

local function safeParent()
    local ok, hui = pcall(function()
        if gethui then return gethui() end
        return game:GetService("CoreGui")
    end)
    if ok and hui then return hui end
    local ok2, pg = pcall(function() return PLR:WaitForChild("PlayerGui", 5) end)
    return (ok2 and pg) or PLR.PlayerGui
end

--============================= ANIMATED TEXT ==================================
-- signature Arsenal effect: a colour wave travelling through the characters
local animEntries = {}

local function registerAnim(holder, chars, T, speed, dim, bright)
    local entry = {
        holder = holder,
        chars = chars,
        c1 = dim or T.ACCENT,
        c2 = bright or T.ACCENT_GLOW,
        speed = speed or 0.6,
        phase = math.random() * 6,
    }
    table.insert(animEntries, entry)
    return entry
end

task.spawn(function()
    while true do
        local base = tick()
        for i = #animEntries, 1, -1 do
            local e = animEntries[i]
            if not e.holder.Parent then
                table.remove(animEntries, i)
            elseif not e.frozen then
                local n = #e.chars
                if n > 0 then
                    local offset = (base * e.speed + e.phase) % 1
                    for idx, lbl in ipairs(e.chars) do
                        local t = ((idx - 1) / n + offset) % 1
                        local w = 0.5 + 0.5 * math.sin(t * math.pi * 2)
                        lbl.TextColor3 = lerpColor(e.c1, e.c2, w)
                    end
                end
            end
        end
        task.wait(0.03)
    end
end)

-- animated letters, returns holder frame + char list
local function animatedLabel(parent, text, charW, charH, textSize, font, T, speed)
    local holder = new("Frame", {
        Size = UDim2.new(0, #text * charW, 0, charH),
        BackgroundTransparency = 1,
        ClipsDescendants = false,
    }, parent)
    local chars = {}
    for i = 1, #text do
        local ch = text:sub(i, i)
        local lbl = new("TextLabel", {
            Size = UDim2.new(0, charW + 1, 0, charH),
            Position = UDim2.new(0, (i - 1) * charW, 0.5, -charH / 2),
            BackgroundTransparency = 1,
            Text = ch,
            TextColor3 = T.TEXT_SEC,
            Font = font or Enum.Font.GothamBold,
            TextSize = textSize or 12,
            TextXAlignment = Enum.TextXAlignment.Center,
        }, holder)
        table.insert(chars, lbl)
    end
    registerAnim(holder, chars, T, speed or 0.55)
    return holder, chars
end

local function staticize(chars, color)
    for _, c in ipairs(chars) do c.TextColor3 = color end
end

