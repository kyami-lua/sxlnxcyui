function Azura:CreateWindow(cfg)
    cfg = cfg or {}
    local T = palette(cfg.Accent)
    Azura._theme = T

    local title    = cfg.Title or "Ugly Hub"
    local subtitle = cfg.SubTitle or cfg.Author or "by sxlnxcy"
    local size     = cfg.Size or UDim2.fromOffset(650, 500)
    local pos      = cfg.Position or UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2)
    local width    = size.X.Offset
    local height   = size.Y.Offset

    local scr = new("ScreenGui", {
        Name = "UglyHub_" .. tostring(title):gsub("%s+", ""),
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100,
    }, cfg.Parent or safeParent())

    -- ambient halo
    local halo = new("Frame", {
        Size = UDim2.new(0, width + 26, 0, height + 26),
        Position = pos - UDim2.fromOffset(13, 13),
        BackgroundColor3 = T.Accent,
        BackgroundTransparency = 0.93,
        BorderSizePixel = 0,
        ZIndex = 0,
    }, scr)
    corner(halo, 26)

    -- drop shadow
    local shadow = new("Frame", {
        Size = UDim2.new(0, width + 8, 0, height + 8),
        Position = pos + UDim2.fromOffset(-4, 2),
        BackgroundColor3 = Color3.fromRGB(0, 0, 0),
        BackgroundTransparency = 0.55,
        BorderSizePixel = 0,
        ZIndex = 1,
    }, scr)
    corner(shadow, 22)

    local main = new("Frame", {
        Name = "Main",
        Size = UDim2.new(0, 0, 0, 0),
        Position = pos,
        BackgroundColor3 = T.Base,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 2,
    }, scr)
    corner(main, 16)
    stroke(main, T.Line, 1, 0.15)

    --============================== TOP BAR ==============================
    local topBar = new("Frame", {
        Name = "TopBar",
        Size = UDim2.new(1, 0, 0, 54),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, main)

    local logo = new("Frame", {
        Size = UDim2.fromOffset(30, 30),
        Position = UDim2.new(0, 16, 0, 12),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
        ZIndex = 4,
    }, topBar)
    corner(logo, 9)
    grad(logo, T.Accent, T.Accent2, 35)
    new("TextLabel", {
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = "U",
        TextColor3 = Color3.fromRGB(255, 255, 255),
        TextSize = 16,
        Font = Enum.Font.GothamBold,
        ZIndex = 5,
    }, logo)

    new("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, -220, 0, 18),
        Position = UDim2.new(0, 56, 0, 11),
        BackgroundTransparency = 1,
        Text = title,
        TextColor3 = T.Text,
        TextSize = 15,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
    }, topBar)

    new("TextLabel", {
        Name = "SubTitle",
        Size = UDim2.new(1, -220, 0, 14),
        Position = UDim2.new(0, 56, 0, 29),
        BackgroundTransparency = 1,
        Text = subtitle .. "  |  v" .. Azura.Version,
        TextColor3 = T.Text3,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 4,
    }, topBar)

    local function winButton(glyph, xOffset, color)
        local b = new("TextButton", {
            Size = UDim2.fromOffset(28, 28),
            Position = UDim2.new(1, xOffset, 0, 13),
            BackgroundColor3 = T.Row,
            BorderSizePixel = 0,
            Text = glyph,
            TextColor3 = T.Text2,
            TextSize = 13,
            Font = Enum.Font.GothamBold,
            AutoButtonColor = false,
            ZIndex = 4,
        }, topBar)
        corner(b, 9)
        b.MouseEnter:Connect(function()
            tween(b, {BackgroundColor3 = color or T.RowHi, TextColor3 = T.Text}, 0.14)
        end)
        b.MouseLeave:Connect(function()
            tween(b, {BackgroundColor3 = T.Row, TextColor3 = T.Text2}, 0.14)
        end)
        return b
    end

    local closeBtn    = winButton("✕", -40, T.Bad)
    local minimizeBtn = winButton("—", -74)

    --============================== SIDEBAR ==============================
    local sideBar = new("Frame", {
        Name = "SideBar",
        Size = UDim2.new(0, 172, 1, -54),
        Position = UDim2.new(0, 0, 0, 54),
        BackgroundColor3 = T.Panel,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, main)

    new("Frame", {
        Size = UDim2.new(0, 1, 1, 0),
        Position = UDim2.new(1, -1, 0, 0),
        BackgroundColor3 = T.Line,
        BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
    }, sideBar)

    -- search
    local searchWrap = new("Frame", {
        Size = UDim2.new(1, -20, 0, 30),
        Position = UDim2.new(0, 10, 0, 10),
        BackgroundColor3 = T.Sunk,
        BorderSizePixel = 0,
    }, sideBar)
    corner(searchWrap, 9)
    local searchStroke = stroke(searchWrap, T.Line, 1, 0.4)

    local glass = new("Frame", {
        Size = UDim2.fromOffset(9, 9),
        Position = UDim2.new(0, 9, 0, 9),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, searchWrap)
    corner(glass, 5)
    stroke(glass, T.Text3, 1.4, 0)
    local glassLeg = new("Frame", {
        Size = UDim2.fromOffset(5, 1.5),
        Position = UDim2.new(0, 16, 0, 19),
        BackgroundColor3 = T.Text3,
        BorderSizePixel = 0,
        Rotation = 45,
    }, searchWrap)

    local search = new("TextBox", {
        Size = UDim2.new(1, -38, 1, 0),
        Position = UDim2.new(0, 30, 0, 0),
        BackgroundTransparency = 1,
        Text = "",
        PlaceholderText = "Search...",
        PlaceholderColor3 = T.Text3,
        TextColor3 = T.Text2,
        TextSize = 12,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ClearTextOnFocus = false,
    }, searchWrap)
    search.Focused:Connect(function() searchStroke.Transparency = 0 ; searchStroke.Color = T.Accent end)
    search.FocusLost:Connect(function() searchStroke.Transparency = 0.4 ; searchStroke.Color = T.Line end)

    local tabScroll = new("ScrollingFrame", {
        Size = UDim2.new(1, -12, 1, -74),
        Position = UDim2.new(0, 6, 0, 50),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = T.Line,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ZIndex = 3,
    }, sideBar)
    list(tabScroll, 4)

    new("TextLabel", {
        Size = UDim2.new(1, -16, 0, 26),
        Position = UDim2.new(0, 10, 1, -30),
        BackgroundTransparency = 1,
        Text = "Ugly Hub  •  v" .. Azura.Version,
        TextColor3 = T.Text3,
        TextSize = 10,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 3,
    }, sideBar)

    --============================== CONTENT ==============================
    local content = new("Frame", {
        Name = "Content",
        Size = UDim2.new(1, -172, 1, -54),
        Position = UDim2.new(0, 172, 0, 54),
        BackgroundColor3 = T.Base,
        BorderSizePixel = 0,
        ZIndex = 3,
    }, main)

    --================================ DRAG ===============================
    local dragging, dragStart, startPos = false, nil, nil
    topBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = main.Position
            tween(main, {Size = UDim2.new(0, width, 0, height)}, 0.15)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            local np = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            main.Position = np
            halo.Position = np - UDim2.fromOffset(13, 13)
            shadow.Position = np + UDim2.fromOffset(-4, 2)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    --============================== WINDOW OBJ ===========================
    local Window = {}
    Window.Gui = scr
    Window.Main = main
    Window.SideBar = tabScroll
    Window.Content = content
    Window.Theme = T
    Window.Tabs = {}
    Window.CurrentTab = nil

    Window.Minimized = false
    function Window:Minimize(state)
        Window.Minimized = (state == nil) and (not Window.Minimized) or state
        if Window.Minimized then
            tween(main, {Size = UDim2.new(0, width, 0, 54)}, 0.32, Enum.EasingStyle.Back)
            minimizeBtn.Text = "+"
        else
            tween(main, {Size = UDim2.new(0, width, 0, height)}, 0.32, Enum.EasingStyle.Back)
            minimizeBtn.Text = "—"
        end
    end

    function Window:Destroy()
        scr:Destroy()
    end

    function Window:Notify(c)
        c = c or {}
        c.Theme = T
        return Azura:Notify(c)
    end

    Window.Accents = Azura.Accents

    minimizeBtn.MouseButton1Click:Connect(function() Window:Minimize() end)
    closeBtn.MouseButton1Click:Connect(function()
        tween(main, {Size = UDim2.new(0, width, 0, 0), BackgroundTransparency = 1}, 0.24).Completed:Connect(function()
            scr:Destroy()
        end)
        tween(halo, {BackgroundTransparency = 1}, 0.2)
        tween(shadow, {BackgroundTransparency = 1}, 0.2)
    end)

    --=============================== TAB =================================
    function Window:Tab(cfg2)
        cfg2 = cfg2 or {}
        local tabTitle = cfg2.Title or "Tab"
        local icon = cfg2.Icon or "◆"

        local btn = new("TextButton", {
            Name = tabTitle,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = T.Panel,
            BorderSizePixel = 0,
            Text = "",
            AutoButtonColor = false,
            ZIndex = 3,
        }, tabScroll)
        corner(btn, 9)
        local btnGrad = grad(btn, T.Accent, T.Accent2, 25)
        btnGrad.Enabled = false

        local hl = new("Frame", {
            Size = UDim2.new(0, 3, 0, 0),
            Position = UDim2.new(0, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0, 0.5),
            BackgroundColor3 = Color3.fromRGB(255, 255, 255),
            BorderSizePixel = 0,
            ZIndex = 5,
        }, btn)
        corner(hl, 2)

        local ico = iconBox(btn, 22, icon, T.Text3)
        ico.Position = UDim2.new(0, 9, 0.5, -11)
        ico.ZIndex = 4

        local lbl = new("TextLabel", {
            Size = UDim2.new(1, -46, 1, 0),
            Position = UDim2.new(0, 38, 0, 0),
            BackgroundTransparency = 1,
            Text = tabTitle,
            TextColor3 = T.Text2,
            TextSize = 13,
            Font = Enum.Font.GothamMedium,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 4,
        }, btn)

        local page = new("ScrollingFrame", {
            Name = tabTitle .. "_Page",
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            BorderSizePixel = 0,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = T.Line,
            ScrollingDirection = Enum.ScrollingDirection.Y,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            Visible = false,
            ZIndex = 3,
        }, content)
        list(page, 12)
        padding(page, 14, 10, 20, 14)

        local Tab = {}
        Tab.Button = btn
        Tab.Content = page
        Tab.Title = tabTitle
        Tab.Sections = {}

        local selected = false
        function Tab:Select()
            for _, t in ipairs(Window.Tabs) do
                t.Content.Visible = false
                t.Button.BackgroundTransparency = 0
                t.Button.BackgroundColor3 = T.Panel
                t.Button:FindFirstChildOfClass("UIGradient").Enabled = false
                iconColor(t._icon, T.Text3)
                t._label.TextColor3 = T.Text2
                t._label.Font = Enum.Font.GothamMedium
                t._hl.Size = UDim2.new(0, 3, 0, 0)
                t._selected = false
            end
            page.Visible = true
            btnGrad.Enabled = true
            btn.BackgroundColor3 = T.Accent
            iconColor(ico, Color3.fromRGB(255, 255, 255))
            lbl.TextColor3 = Color3.fromRGB(255, 255, 255)
            lbl.Font = Enum.Font.GothamBold
            tween(hl, {Size = UDim2.new(0, 3, 0, 20)}, 0.2)
            selected = true
            Tab._selected = true
            Window.CurrentTab = Tab
        end

        btn.MouseEnter:Connect(function()
            if not selected then tween(btn, {BackgroundColor3 = T.Card}, 0.14) end
        end)
        btn.MouseLeave:Connect(function()
            if not selected then tween(btn, {BackgroundColor3 = T.Panel}, 0.14) end
        end)
        btn.MouseButton1Click:Connect(function() Tab:Select() end)

        Tab._icon = ico
        Tab._label = lbl
        Tab._hl = hl
        Tab._selected = false

        table.insert(Window.Tabs, Tab)

        search:GetPropertyChangedSignal("Text"):Connect(function()
            local q = string.lower(search.Text)
