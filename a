            --======================== DROPDOWN =========================
            function Section:Dropdown(cfg4)
                cfg4 = cfg4 or {}
                local values = cfg4.Values or {"Option 1", "Option 2"}
                local multi = cfg4.Multi and true or false
                local selected
                if multi then
                    selected = cfg4.Default or cfg4.Value or {}
                    if type(selected) ~= "table" then selected = {selected} end
                else
                    selected = cfg4.Default or cfg4.Value or values[1]
                end
                local cb = cfg4.Callback or function() end

                local r = makeRow(32)
                new("TextLabel", {
                    Size = UDim2.new(1, -150, 0, 16),
                    Position = UDim2.new(0, 12, 0.5, -8),
                    BackgroundTransparency = 1,
                    Text = cfg4.Title or "Dropdown",
                    TextColor3 = T.Text,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)

                local head = new("TextButton", {
                    Size = UDim2.new(0, 118, 0, 20),
                    Position = UDim2.new(1, -130, 0.5, -10),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 6,
                }, r)
                corner(head, 5)
                stroke(head, T.Line, 1, 0.45)

                local valueLbl = new("TextLabel", {
                    Size = UDim2.new(1, -30, 1, 0),
                    Position = UDim2.new(0, 8, 0, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    TextColor3 = T.Text2,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 7,
                }, head)

                local chev = makeChevron(head, 9, T.Text3)
                chev.Position = UDim2.new(1, -11, 0.5, 0)

                local listFrame = new("Frame", {
                    Size = UDim2.new(1, -20, 0, 0),
                    Position = UDim2.new(0, 10, 0, 36),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Visible = false,
                    ZIndex = 6,
                }, r)
                corner(listFrame, 6)
                vlist(listFrame, 0)
                pad(listFrame, 3, 3, 3, 3)

                local open = false
                local rows = {}

                local function updateText()
                    if multi then
                        valueLbl.Text = (#selected == 0) and "None" or table.concat(selected, ", ")
                    else
                        valueLbl.Text = tostring(selected)
                    end
                end

                local function picked(v)
                    if multi then
                        for _, s in ipairs(selected) do
                            if s == v then return true end
                        end
                        return false
                    end
                    return selected == v
                end

                local function refresh()
                    for _, item in ipairs(rows) do
                        local on = picked(item.value)
                        item.lbl.TextColor3 = on and T.Accent2 or T.Text2
                        item.check.Visible = on
                    end
                end

                for i, v in ipairs(values) do
                    local item = new("TextButton", {
                        Size = UDim2.new(1, 0, 0, 24),
                        BackgroundColor3 = T.Sunk,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        ZIndex = 7,
                        LayoutOrder = i,
                    }, listFrame)
                    corner(item, 5)
                    local lbl = new("TextLabel", {
                        Size = UDim2.new(1, -30, 1, 0),
                        Position = UDim2.new(0, 8, 0, 0),
                        BackgroundTransparency = 1,
                        Text = tostring(v),
                        TextColor3 = T.Text2,
                        TextSize = 11,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 8,
                    }, item)
                    local check = makeCheck(item, 10, T.Accent2)
                    check.Position = UDim2.new(1, -12, 0.5, 0)
                    check.Visible = false
                    table.insert(rows, {value = v, lbl = lbl, check = check})

                    local base = T.Sunk
                    item.MouseEnter:Connect(function() tween(item, {BackgroundColor3 = T.Card2}, 0.1) end)
                    item.MouseLeave:Connect(function() tween(item, {BackgroundColor3 = base}, 0.1) end)

                    item.MouseButton1Click:Connect(function()
                        if multi then
                            local idx
                            for i2, s in ipairs(selected) do
                                if s == v then idx = i2 end
                            end
                            if idx then
                                table.remove(selected, idx)
                            else
                                table.insert(selected, v)
                            end
                        else
                            selected = v
                            open = false
                            listFrame.Visible = false
                            tween(chev, {Rotation = 0}, 0.14)
                            tween(r, {Size = UDim2.new(1, 0, 0, 32)}, 0.16)
                        end
                        updateText()
                        refresh()
                        pcall(cb, selected)
                    end)
                end

                local function toggle()
                    open = not open
                    listFrame.Visible = open
                    listFrame.Size = UDim2.new(1, -20, 0, #values * 24 + 6)
                    tween(chev, {Rotation = open and 180 or 0}, 0.16, Enum.EasingStyle.Quart)
                    tween(r, {Size = UDim2.new(1, 0, 0, open and (42 + #values * 24) or 32)}, 0.18, Enum.EasingStyle.Quart)
                end

                hoverIn(head,
                    {BackgroundColor3 = T.Card2},
                    {BackgroundColor3 = T.Sunk})
                head.MouseButton1Click:Connect(toggle)

                local Dropdown = {}
                function Dropdown:Set(v)
                    selected = v
                    if multi and type(v) ~= "table" then selected = {v} end
                    updateText()
                    refresh()
                    pcall(cb, selected)
                end
                function Dropdown:Get() return selected end
                updateText()
                refresh()
                return Dropdown
            end

            --========================== INPUT ==========================
            function Section:Input(cfg4)
                cfg4 = cfg4 or {}
                local cb = cfg4.Callback or function() end

                local r = makeRow(32)
                new("TextLabel", {
                    Size = UDim2.new(1, -150, 0, 16),
                    Position = UDim2.new(0, 12, 0.5, -8),
                    BackgroundTransparency = 1,
                    Text = cfg4.Title or "Input",
                    TextColor3 = T.Text,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)

                local box = new("TextBox", {
                    Size = UDim2.new(0, 118, 0, 20),
                    Position = UDim2.new(1, -130, 0.5, -10),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Text = cfg4.Value or "",
                    PlaceholderText = cfg4.Placeholder or "Type...",
                    PlaceholderColor3 = T.Text3,
                    TextColor3 = T.Text2,
                    TextSize = 11,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    ZIndex = 6,
                }, r)
                corner(box, 5)
                local bs = stroke(box, T.Line, 1, 0.45)
                pad(box, 0, 6, 0, 8)

                box.Focused:Connect(function()
                    bs.Color = T.Accent
                    bs.Transparency = 0.2
                end)
                box.FocusLost:Connect(function(enter)
                    bs.Color = T.Line
                    bs.Transparency = 0.45
                    if enter then pcall(cb, box.Text) end
                end)

                return {
                    Box = box,
                    Set = function(_, t) box.Text = t end,
                    Get = function() return box.Text end,
                }
            end

            --======================= COLORPICKER =======================
            function Section:Colorpicker(cfg4)
                cfg4 = cfg4 or {}
                local color = cfg4.Default or Color3.fromRGB(120, 120, 120)
                local cb = cfg4.Callback or function() end
                local list = cfg4.Colors or {
                    Color3.fromRGB(255, 86, 86),  Color3.fromRGB(255, 148, 76), Color3.fromRGB(250, 208, 84),
                    Color3.fromRGB(140, 224, 96), Color3.fromRGB(72, 214, 148), Color3.fromRGB(56, 208, 220),
                    Color3.fromRGB(74, 148, 255), Color3.fromRGB(126, 96, 255), Color3.fromRGB(184, 108, 255),
                    Color3.fromRGB(246, 108, 194),Color3.fromRGB(255, 255, 255), Color3.fromRGB(144, 150, 168),
                }

                local r = makeRow(32)
                new("TextLabel", {
                    Size = UDim2.new(1, -80, 0, 16),
                    Position = UDim2.new(0, 12, 0.5, -8),
                    BackgroundTransparency = 1,
                    Text = cfg4.Title or "Color",
                    TextColor3 = T.Text,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)

                local swatch = new("TextButton", {
                    Size = UDim2.fromOffset(30, 18),
                    Position = UDim2.new(1, -42, 0, 7),
                    BackgroundColor3 = color,
                    BorderSizePixel = 0,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 6,
                }, r)
                corner(swatch, 5)
                stroke(swatch, Color3.fromRGB(255, 255, 255), 1, 0.8)

                local grid = new("Frame", {
                    Size = UDim2.new(1, -20, 0, 0),
                    Position = UDim2.new(0, 10, 0, 34),
                    BackgroundTransparency = 1,
                    Visible = false,
                    ZIndex = 6,
                }, r)
                new("UIGridLayout", {
                    CellSize = UDim2.new(1 / 6, -4, 0, 18),
                    CellPadding = UDim2.fromOffset(5, 5),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    FillDirectionMaxCells = 6,
                }, grid)

                local rowsCount = math.ceil(#list / 6)
                local gridH = rowsCount * 23

                local chips = {}
                local open = false

                local function mark()
                    for _, c in ipairs(chips) do
                        c.s.Transparency = (c.color == color) and 0 or 0.75
                        c.s.Color = (c.color == color) and Color3.fromRGB(255, 255, 255) or T.Line
                    end
                end

                for i, c in ipairs(list) do
                    local chip = new("TextButton", {
                        BackgroundColor3 = c,
                        BorderSizePixel = 0,
                        Text = "",
                        AutoButtonColor = false,
                        ZIndex = 7,
                        LayoutOrder = i,
                    }, grid)
                    corner(chip, 5)
                    local s = stroke(chip, T.Line, 1, 0.75)
                    table.insert(chips, {color = c, s = s})
                    chip.MouseButton1Click:Connect(function()
                        color = c
                        swatch.BackgroundColor3 = c
                        mark()
                        pcall(cb, c)
                    end)
                end

                swatch.MouseButton1Click:Connect(function()
                    open = not open
                    grid.Visible = open
                    grid.Size = UDim2.new(1, -20, 0, gridH)
                    tween(r, {Size = UDim2.new(1, 0, 0, open and (40 + gridH) or 32)}, 0.18, Enum.EasingStyle.Quart)
                end)

                local Colorpicker = {}
                function Colorpicker:Set(c)
                    color = c
                    swatch.BackgroundColor3 = c
                    mark()
                    pcall(cb, c)
                end
                function Colorpicker:Get() return color end
                mark()
                return Colorpicker
            end

            --======================== KEYBIND ==========================
            function Section:Keybind(cfg4)
                cfg4 = cfg4 or {}
                local key = cfg4.Value or "F"
                local cb = cfg4.Callback or function() end
                local pressed = cfg4.Pressed

                local r = makeRow(32)
                new("TextLabel", {
                    Size = UDim2.new(1, -90, 0, 16),
                    Position = UDim2.new(0, 12, 0.5, -8),
                    BackgroundTransparency = 1,
                    Text = cfg4.Title or "Keybind",
                    TextColor3 = T.Text,
                    TextSize = 12,
                    Font = Enum.Font.Gotham,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)

                local b = new("TextButton", {
                    Size = UDim2.fromOffset(58, 20),
                    Position = UDim2.new(1, -70, 0.5, -10),
                    BackgroundColor3 = T.Sunk,
                    BorderSizePixel = 0,
                    Text = key,
                    TextColor3 = T.Text2,
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                    ZIndex = 6,
                }, r)
                corner(b, 5)
                local bs = stroke(b, T.Line, 1, 0.45)

                local listening = false
                local conn

                local function stop()
                    listening = false
                    if conn then conn:Disconnect() ; conn = nil end
                    bs.Color = T.Line
                    bs.Transparency = 0.45
                    tween(b, {BackgroundColor3 = T.Sunk}, 0.12)
                end

                b.MouseButton1Click:Connect(function()
                    if listening then
                        stop()
                        b.Text = key
                        return
                    end
                    listening = true
                    b.Text = "..."
                    bs.Color = T.Accent
                    bs.Transparency = 0.15
                    tween(b, {BackgroundColor3 = T.Card2}, 0.12)
                    conn = UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                        if input.KeyCode == Enum.KeyCode.Escape then
                            b.Text = key
                        elseif input.KeyCode == Enum.KeyCode.Backspace then
                            key = "None"
                            b.Text = key
                            pcall(cb, key)
                        else
                            key = input.KeyCode.Name
                            b.Text = key
                            pcall(cb, key)
                        end
                        stop()
                    end)
                end)

                if pressed then
                    UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == key then
                            pcall(pressed)
                        end
                    end)
                end

                local Keybind = {}
                function Keybind:Set(k)
                    key = k
                    b.Text = k
                    pcall(cb, k)
                end
                function Keybind:Get() return key end
                return Keybind
            end

            --======================= PARAGRAPH ========================
            function Section:Paragraph(cfg4)
                cfg4 = cfg4 or {}
                local desc = cfg4.Desc or ""
                local lines = math.max(1, math.ceil(#desc / 44))
                local h = (desc == "") and 34 or (26 + lines * 14)

                local r = makeRow(h)
                new("TextLabel", {
                    Size = UDim2.new(1, -24, 0, 16),
                    Position = UDim2.new(0, 12, 0, 7),
                    BackgroundTransparency = 1,
                    Text = cfg4.Title or "Info",
                    TextColor3 = T.Text,
                    TextSize = 12,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)

                if desc ~= "" then
                    new("TextLabel", {
                        Size = UDim2.new(1, -24, 0, lines * 14),
                        Position = UDim2.new(0, 12, 0, 24),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextColor3 = T.Text3,
                        TextSize = 10,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top,
                        TextWrapped = true,
                        ZIndex = 6,
                    }, r)
                end
                return r
            end

            function Section:Divider()
                count = count + 1
                return separator()
            end

            function Section:Label(text, desc)
                local r = makeRow(desc and 38 or 24)
                new("TextLabel", {
                    Size = UDim2.new(1, -24, 0, 14),
                    Position = UDim2.new(0, 12, desc and 5 or 5),
                    BackgroundTransparency = 1,
                    Text = text or "",
                    TextColor3 = T.Text3,
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)
                if desc then
                    new("TextLabel", {
                        Size = UDim2.new(1, -24, 0, 14),
                        Position = UDim2.new(0, 12, 0, 20),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextColor3 = T.Text3,
                        TextSize = 10,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 6,
                    }, r)
                end
                return r
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        if #Window.Tabs == 1 then
            Tab:Select()
        end

        return Tab
    end

    --============================ INTRO ==============================
    task.defer(function()
        main.Size = UDim2.new(0, width, 0, 0)
        tween(main, {Size = UDim2.new(0, width, 0, height)}, 0.34, Enum.EasingStyle.Quart)
        tween(shadow, {BackgroundTransparency = 0.6}, 0.4)
    end)

    return Window
end

