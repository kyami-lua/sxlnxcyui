        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, card)

    local prog = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2), Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = T.ACCENT, BorderSizePixel = 0,
    }, card)
    grad(prog, T.ACCENT, T.ACCENT_GLOW, 0)

    local lines = math.max(1, math.ceil(#(cfg.Content or "") / 38))
    local actionY = 28 + lines * 13
    local actions = cfg.Actions or {}
    local count = #actions
    local widths, total = {}, 0
    for i, act in ipairs(actions) do
        widths[i] = math.min(130, #(act.Text or "OK") * 6 + 22)
        total = total + widths[i]
    end
    if count > 0 then total = total + (count - 1) * 6 end
    local ax = (W - total) / 2
    for i, act in ipairs(actions) do
        local b = new("TextButton", {
            Size = UDim2.fromOffset(widths[i], 22), Position = UDim2.fromOffset(ax, actionY),
            BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, Text = "",
            AutoButtonColor = false, BorderSizePixel = 0,
        }, card)
        corner(b, 5)
        stroke(b, T.BORDER, 1, 0.5)
        new("TextLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = act.Text or "OK",
            TextColor3 = T.TEXT_PRI, TextSize = 10, Font = Enum.Font.GothamBold,
        }, b)
        hover(b, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.PANEL})
        b.MouseButton1Click:Connect(function()
            pcall(act.Callback or function() end)
            if act.Close ~= false then card:Destroy() end
        end)
        ax = ax + widths[i] + 6
    end
    local listH = count > 0 and 28 or 0

    local targetH = 28
    local function applyHeight()
        tw(card, {Size = UDim2.new(0, W, 0, targetH), Position = UDim2.new(0, 0, 0, 0)}, 0.32, Enum.EasingStyle.Quart)
    end
    task.defer(function()
        local h = math.clamp(28 + body.TextBounds.Y + 12 + listH, 58, 200)
        targetH = h
        applyHeight()
    end)

    local dead = false
    local function kill()
        if dead then return end
        dead = true
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") then tw(d, {TextTransparency = 1}, 0.16) end
            if d:IsA("Frame") or d:IsA("TextButton") then tw(d, {BackgroundTransparency = 1}, 0.16) end
        end
        tw(card, {Position = UDim2.new(0, 60, 0, 0)}, 0.2, Enum.EasingStyle.Quart)
            .Completed:Connect(function() card:Destroy() end)
    end

    if cfg.Duration == 0 or cfg.Sticky then
        prog.Visible = false
    else
        local duration = cfg.Duration or 4
        task.spawn(function()
            local elapsed = 0
            local steps = math.max(10, math.floor(duration * 25))
            local dt = duration / steps
            for i = 1, steps do
                if dead or not card.Parent then return end
                while mouseOver(card) and card.Parent do
                    task.wait(0.08)
                end
                elapsed = elapsed + dt
                prog.Size = UDim2.new(math.clamp(1 - elapsed / duration, 0, 1), 0, 0, 2)
                task.wait(dt)
            end
            kill()
        end)
    end

    -- close on right click
    card.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then kill() end
    end)
    return card
end

