                if scrolls then
                    listParent = new("ScrollingFrame", {
                        Size = UDim2.new(1, 0, 0, 0), Position = UDim2.new(0, 0, 0, 38),
                        BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 3,
