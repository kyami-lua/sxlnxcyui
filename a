local function shade(c, f)
    return Color3.fromRGB(
        math.clamp(math.floor(c.R * 255 * f), 0, 255),
        math.clamp(math.floor(c.G * 255 * f), 0, 255),
        math.clamp(math.floor(c.B * 255 * f), 0, 255))
end

local function lerpColor(a, b, t)
    return Color3.fromRGB(
        math.floor(a.R * 255 + (b.R - a.R) * 255 * t),
        math.floor(a.G * 255 + (b.G - a.G) * 255 * t),
        math.floor(a.B * 255 + (b.B - a.B) * 255 * t))
end

local function buildPalette(themeName, accentName)
    local th = Azura.Themes[themeName] or Azura.Themes.Dark
    local a  = Azura.Accents[accentName] or Azura.Accents.Red
    local function c(t) return Color3.fromRGB(t[1], t[2], t[3]) end
    return {
        THEME = themeName, ACCENT_NAME = accentName,
        BG = c(th.BG), SURFACE = c(th.SURFACE), PANEL = c(th.PANEL), CARD = c(th.CARD),
        CARD_HOVER = c(th.HOVER), GRADIENT_TOP = c(th.TOP), BORDER = c(th.BORDER),
        TEXT_PRI = c(th.PRI), TEXT_SEC = c(th.SEC), TEXT_MUTED = c(th.MUTED),
        ACCENT = a[1], ACCENT_DIM = shade(a[1], 0.5), ACCENT_DEEP = shade(a[1], 0.3),
        ACCENT_GLOW = a[2], ACCENT_FADE = lerpColor(c(th.CARD), a[1], 0.22),
        ALPHA = th.ALPHA or 0, LIGHT = th.LIGHT and true or false,
        SUCCESS = Color3.fromRGB(50, 200, 80), WARN = Color3.fromRGB(240, 186, 76),
        DANGER = Color3.fromRGB(238, 84, 96), WHITE = Color3.fromRGB(255, 255, 255),
    }
end

Azura.Palette = buildPalette

--================================ PRIMITIVES ==================================
local function new(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            o[k] = v
        end
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(o, r)
    return new("UICorner", {CornerRadius = UDim.new(0, r or 6)}, o)
end

local function stroke(o, color, thickness, transparency)
    return new("UIStroke", {
        Color = color, Thickness = thickness or 1, Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end

local function pad(o, top, right, bottom, left)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, top or 0), PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0), PaddingLeft = UDim.new(0, left or 0),
    }, o)
end

local function vlist(o, gap)
    return new("UIListLayout", {
        Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Vertical,
    }, o)
end

local function hlist(o, gap)
    return new("UIListLayout", {
        Padding = UDim.new(0, gap or 0), SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = Enum.FillDirection.Horizontal,
    }, o)
end

local function grad(o, c1, c2, rot)
    return new("UIGradient", {Color = ColorSequence.new(c1, c2), Rotation = rot or 0}, o)
end

local function tw(o, props, time, style, dir)
    local t = TS:Create(o, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function hover(obj, on, off, time)
    obj.MouseEnter:Connect(function() tw(obj, on, time or 0.12) end)
    obj.MouseLeave:Connect(function() tw(obj, off, time or 0.14) end)
end

local function safeParent()
    local ok, hui = pcall(function()
        if gethui then return gethui() end
        return game:GetService("CoreGui")
    end)
    if ok and hui then return hui end
    local ok2, pg = pcall(function() return PLR:WaitForChild("PlayerGui", 5) end)
    return (ok2 and pg) or PLR.PlayerGui
end

local function hex(c)
    return string.format("#%02X%02X%02X",
        math.clamp(math.floor(c.R * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.G * 255 + 0.5), 0, 255),
        math.clamp(math.floor(c.B * 255 + 0.5), 0, 255))
end

local function fromHex(s)
    s = tostring(s):gsub("#", "")
    if #s == 3 then s = s:sub(1, 1):rep(2) .. s:sub(2, 2):rep(2) .. s:sub(3, 3):rep(2) end
    if #s ~= 6 or s:find("%X") then return nil end
    return Color3.fromRGB(tonumber(s:sub(1, 2), 16), tonumber(s:sub(3, 4), 16), tonumber(s:sub(5, 6), 16))
end

-- fuzzy subsequence match, returns true + score (lower is better)
local function fuzzy(text, query)
    if query == "" then return true, 0 end
    local t, score, ti = string.lower(text), 0, 0
    for i = 1, #query do
        local ch = query:sub(i, i)
        if ch ~= " " then
            local found = string.find(t, ch, ti + 1, true)
            if not found then return false, math.huge end
            score = score + (found - ti)
            ti = found
        end
    end
    return true, score
end
Azura.Fuzzy = fuzzy

