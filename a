local function rect(p, x, y, w, h, color, rot, r)
    local f = new("Frame", {
        Size = UDim2.fromOffset(w, h),
        Position = UDim2.fromOffset(x, y),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundColor3 = color,
        BorderSizePixel = 0,
        Rotation = rot or 0,
    }, p)
    if r and r > 0 then corner(f, r) end
    return f
end

local function ring(p, x, y, size, thickness, color)
    local f = new("Frame", {
        Size = UDim2.fromOffset(size, size),
        Position = UDim2.fromOffset(x, y),
        AnchorPoint = Vector2.new(0.5, 0.5),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
    }, p)
    corner(f, 999)
    stroke(f, color, thickness or 1.4, 0)
    return f
end

