local function hookNameCallAbuse() return end -- (reserved)

local function enhanceElement(obj, cfg, kind)
    if not obj then return obj end
    if obj.__enhanced then return obj end
    obj.__enhanced = true
    obj._cfg = cfg or {}
    obj._kind = kind or "element"

    local events = {}
    local function fire(name, ...)
        for i = #events, 1, -1 do
            local e = events[name]
            if e and e[i] then
                pcall(e[i], ...)
            end
        end
    end

    -- Connects
    function obj.Connect(evName, fn)
        events[evName] = events[evName] or {}
        local list = events[evName]
        table.insert(list, fn)
        return { Disconnect = function()
            for i = #list, 1, -1 do
                if list[i] == fn then table.remove(list, i) end
            end
        end }
    end
    function obj.Disconnect(evName)
        events[evName] = {}
    end
    function obj.OnChanged(fn)
        return obj:Connect("change", fn)
    end

    -- State
    function obj.GetState()
        if obj.Get then
            local ok, v = pcall(function() return obj:Get() end)
            return ok and v or nil
        end
        return nil
    end
    function obj.SetStateEnabled(enabled)
        local row = obj.Row
        if row then
            row.Active = enabled and true or false
            row.Visible = enabled
        end
        if obj.Button then obj.Button.Active = enabled end
        return obj
    end

    -- Desc
    function obj.SetDesc(text)
        local row = obj.Row
        if row then
            for _, d in ipairs(pcall(function() return row:GetDescendants() end) or {}) do
                if d:IsA("TextLabel") and d.TextSize <= 9 and #d.Text > 0 then
                    d.Text = tostring(text)
                    break
                end
            end
        end
        return obj
    end

    function obj.SetValue(v) obj:Set(v) return obj end
    function obj.SetValues(...)
        local a = { ... }
        if #a == 1 then obj:Set(a[1]) else obj:Set(a) end
        return obj
    end

    -- Refresh: re-fire the Callback with current value
    function obj.Refresh()
        local cb = cfg and cfg.Callback
        if type(cb) == "function" then
            local v = obj:GetState()
            pcall(cb, v, obj)
        end
        return obj
    end

    -- SetToggleKey: press a key while this toggle exists to flip it
    if kind == "Toggle" and UIS then
        local kbConn = UIS.InputBegan:Connect(function(input, gpe)
            if gpe then return end
            if input.KeyCode and cfg.Key and tostring(input.KeyCode) == tostring(cfg.Key) then
                obj:Set(not (obj:GetState() == true))
                fire("key", obj:GetState())
            end
        end)
        if obj.Disconnect then
            local orig = obj.Disconnect
            obj.Disconnect = function(...)
                pcall(function() kbConn:Disconnect() end)
                return orig(...)
            end
        end
    end

    -- Wrap Set so every set fires events (preserve existing Set)
    local baseSet = obj.Set
    if baseSet then
        obj.Set = function(self, v)
            local ok, res = pcall(baseSet, self, v)
            if not ok then baseSet(v) end
            fire("change", v, obj)
            return obj
        end
    end
    return obj
end

