    function Window:SaveConfig(filename)
        filename = filename or "UglyHub_Config.json"
        if not writefile then return false end
        local ok = pcall(function()
            writefile(filename, game:GetService("HttpService"):JSONEncode(Window.Flags))
        end)
        if ok then self:Notify({Title = "Config saved", Content = filename, Duration = 2}) end
        return ok
    end

    function Window:LoadConfig(filename)
        filename = filename or "UglyHub_Config.json"
        if not (isfile and readfile) then return false end
        local ok, data = pcall(function()
            if not isfile(filename) then return nil end
            return game:GetService("HttpService"):JSONDecode(readfile(filename))
        end)
        if not ok or type(data) ~= "table" then return false end
        for flag, value in pairs(data) do
            if setters[flag] then pcall(setters[flag], value) end
        end
        self:Notify({Title = "Config loaded", Content = filename, Duration = 2})
        return true
    end

