                        ZIndex = 7,
                    }, grid)
                    corner(chip, 4)
                    local s = stroke(chip, T.BORDER, 1, 0.75)
                    table.insert(chips, {color = c, s = s})
                    chip.MouseButton1Click:Connect(function()
                        color = c
                        swatch.BackgroundColor3 = c
                        mark()
                        if cfg4.Flag then
                            Window.Flags[cfg4.Flag] = {R = c.R, G = c.G, B = c.B}
                        end
                        pcall(cb, c)
                    end)
                end

                local open = false
                swatch.MouseButton1Click:Connect(function()
                    open = not open
                    grid.Visible = open
                    grid.Size = UDim2.new(1, -20, 0, gridH)
                    local h2 = open and (46 + gridH) or 38
                    tw(r, {Size = UDim2.new(1, 0, 0, h2)}, 0.18, Enum.EasingStyle.Quart)
                    if Section.Grouped then Section._sizeCard() end
                end)

                local Colorpicker = {}
                function Colorpicker:Set(c)
                    color = c
                    swatch.BackgroundColor3 = c
                    mark()
                    pcall(cb, c)
                end
                function Colorpicker:Get() return color end
                function Colorpicker:SetValue(c)
                    if type(c) == "table" and c.R then c = Color3.fromRGB(c.R * 255, c.G * 255, c.B * 255) end
                    color = c
                    swatch.BackgroundColor3 = c
                    mark()
                end
                mark()
                return Colorpicker
            end

            --======================= PARAGRAPH ==========================
            function Section:Paragraph(cfg4)
                cfg4 = cfg4 or {}
                local desc = cfg4.Desc or ""
                local lines = math.max(1, math.ceil(#desc / 42))
                local h = (desc == "") and 34 or (24 + lines * 12)

                local r = buildRow(h, cfg4.Title or "Info")
                local x = iconSlot(r, cfg4.Icon, 6)
                rowLabel(r, cfg4.Title or "Info", 6, x)
                if desc ~= "" then
                    new("TextLabel", {
                        Size = UDim2.new(1, -20 - (x - 10), 0, lines * 12),
                        Position = UDim2.new(0, x, 0, 22),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextColor3 = T.TEXT_MUTED,
                        TextSize = 9,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top,
                        TextWrapped = true,
                        ZIndex = 6,
                    }, r)
                end
                return r
            end

            function Section:Label(text, desc)
                local r = buildRow(desc and 34 or 22, text or "")
                new("TextLabel", {
                    Size = UDim2.new(1, -20, 0, 12),
                    Position = UDim2.new(0, 10, 0, 5),
                    BackgroundTransparency = 1,
                    Text = text or "",
                    TextColor3 = T.TEXT_SEC,
                    TextSize = 9,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ZIndex = 6,
                }, r)
                if desc then
                    new("TextLabel", {
                        Size = UDim2.new(1, -20, 0, 12),
                        Position = UDim2.new(0, 10, 0, 18),
                        BackgroundTransparency = 1,
                        Text = desc,
                        TextColor3 = T.TEXT_MUTED,
                        TextSize = 9,
                        Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 6,
                    }, r)
                end
                return r
            end

            function Section:Divider()
                if grouped then
                    local r = buildRow(1, "divider")
                    r.BackgroundTransparency = 1
                    return r
                end
                local line = new("Frame", {
                    Size = UDim2.new(1, -8, 0, 1),
                    BackgroundColor3 = T.BORDER,
                    BackgroundTransparency = 0.35,
                    BorderSizePixel = 0,
                    ZIndex = 4,
                }, page)
                return line
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        if #Window.Tabs == 1 then
            Tab:Select()
        end
        return Tab
    end

    --============================== INTRO ===============================
    task.defer(function()
        tw(glow, {BackgroundTransparency = 0.93}, 0.5)
        tw(shadow, {BackgroundTransparency = 0.55}, 0.5)
    end)

    _G.UglyHubWindow = Window
    _G.UglyHubCleanup = function() Window:Destroy() end
    return Window
end

--================================= ALIASES ====================================
Azura.Create = Azura.CreateWindow
Azura.new = Azura.CreateWindow

return Azura
