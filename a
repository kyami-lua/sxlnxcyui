                corner(hexBox, 5)
                local hbs = stroke(hexBox, T.BORDER, 1, 0.5)

                local grid = new("Frame", {
                    Size = UDim2.new(1, -100, 0, 48), Position = UDim2.new(0, 100, 0, 84),
                    BackgroundTransparency = 1, ZIndex = 7,
                }, panel)
                new("UIGridLayout", {
                    CellSize = UDim2.new(0.1666, -4, 0, 20), CellPadding = UDim2.fromOffset(4, 4),
                    SortOrder = Enum.SortOrder.LayoutOrder,
                }, grid)

                local chips = {}
                local h, s, v = Color3.toHSV(color)
                local function paint()
                    sv.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
                    svCursor.Position = UDim2.new(s, 0, 1 - v, 0)
                    hueCursor.Position = UDim2.new(h, 0, 0.5, 0)
                    swatch.BackgroundColor3 = color
                    hexLbl.Text = hex(color)
                    hexBox.Text = hex(color)
                    for _, c in ipairs(chips) do
                        local on = (math.abs(c.color.R - color.R) < 0.01 and math.abs(c.color.G - color.G) < 0.01
                                    and math.abs(c.color.B - color.B) < 0.01)
                        c.s.Transparency = on and 0 or 0.7
                        c.s.Color = on and T.WHITE or T.BORDER
                    end
                end
                local function commit(newColor, silent)
                    color = newColor
                    h, s, v = Color3.toHSV(color)
                    if cfg4.Flag then
                        Window.Flags[cfg4.Flag] = {R = color.R, G = color.G, B = color.B}
                    end
                    if Window._scheduleAutosave and not silent then Window._scheduleAutosave() end
                    paint()
                    if not silent then pcall(cb, color) end
                end

                for i, c in ipairs(presets) do
                    local chip = new("TextButton", {
                        Name = "Swatch", BackgroundColor3 = c, BorderSizePixel = 0, Text = "",
                        AutoButtonColor = false, LayoutOrder = i, ZIndex = 8,
                    }, grid)
                    corner(chip, 4)
                    local cs = stroke(chip, T.BORDER, 1, 0.7)
                    table.insert(chips, {color = c, s = cs})
                    on(chip.MouseButton1Click, function() commit(c) end)
                end

                local function svFromPoint(px, py)
                    local ap, as = sv.AbsolutePosition, sv.AbsoluteSize
                    local ns = math.clamp((px - ap.X) / math.max(1, as.X), 0, 1)
                    local nv = 1 - math.clamp((py - ap.Y) / math.max(1, as.Y), 0, 1)
                    commit(Color3.fromHSV(h, ns, nv))
                end
                local svDrag = false
                on(svHit.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        svDrag = true
                        svFromPoint(input.Position.X, input.Position.Y)
                    end
                end)
                local hueDrag = false
                local function hueFromPoint(px)
                    local ap, as = hueBar.AbsolutePosition, hueBar.AbsoluteSize
                    commit(Color3.fromHSV(math.clamp((px - ap.X) / math.max(1, as.X), 0, 1), s, v))
                end
                on(hueHit.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        hueDrag = true
                        hueFromPoint(input.Position.X)
                    end
                end)
                on(UIS.InputChanged, function(input)
                    if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                    if svDrag then svFromPoint(input.Position.X, input.Position.Y) end
                    if hueDrag then hueFromPoint(input.Position.X) end
                end)
                on(UIS.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        svDrag, hueDrag = false, false
                    end
                end)
                on(hexBox.FocusLost, function()
                    local c = fromHex(hexBox.Text)
                    if c then commit(c) else hexBox.Text = hex(color) end
                end)

                local open = false
                local function sizeOpen(state)
                    open = state
                    panel.Visible = state
                    local newH = state and (44 + openH + 8) or 38
                    if perf then
                        r.Size = UDim2.new(1, 0, 0, newH)
                    else
                        tw(r, {Size = UDim2.new(1, 0, 0, newH)}, 0.2, Enum.EasingStyle.Quart)
                    end
                    if Section.Grouped then Section._sizeCard() end
                end
                on(swatch.MouseButton1Click, function() sizeOpen(not open) end)

                local Colorpicker = {}
                local function set(c, silent)
                    if type(c) == "table" then c = Color3.fromRGB((c.R or 0) * 255, (c.G or 0) * 255, (c.B or 0) * 255) end
                    commit(c, silent)
                end
                entry.set = function(c) set(c) end
                entry.get = function() return color end
                entry.reset = function(silent) set(cfg4.Default or T.ACCENT, silent) end
                reg(entry, entry.set, entry.get, entry.reset)
                function Colorpicker:Set(c) set(c) end
                function Colorpicker:Get() return color end
                function Colorpicker:SetValue(c) set(c, true) end
                function Colorpicker:Reset() entry.reset() end
                function Colorpicker:GetHex() return hex(color) end
                function Colorpicker:Open() sizeOpen(true) end
                function Colorpicker:Close() sizeOpen(false) end
                Colorpicker.Row = r
                R(function(T2)
                    ss.Color = T2.WHITE
                    hexLbl.TextColor3 = T2.TEXT_MUTED
                    hexBox.BackgroundColor3 = T2.PANEL
                    hexBox.BackgroundTransparency = T2.ALPHA
                    hexBox.TextColor3 = T2.TEXT_PRI
                    hbs.Color = T2.BORDER
                    hueCursor.BackgroundColor3 = T2.WHITE
                    for _, c in ipairs(chips) do
                        if c.s.Transparency > 0.4 then c.s.Color = T2.BORDER end
                    end
                end)
                paint()
                return Colorpicker
            end

            --========================= SEGMENT ==========================
            function Section:Segment(cfg4)
                cfg4 = cfg4 or {}
                local values = cfg4.Values or cfg4.Options or {"On", "Off"}
                local index = 1
                if cfg4.Default then
                    for i, v in ipairs(values) do
                        if v == cfg4.Default then index = i end
                    end
                end
                local cb = cfg4.Callback or function() end

                local r, entry = buildRow(38, cfg4.Title or "Segment", {flag = cfg4.Flag, extra = table.concat(values, " ")})
                local x = iconSlot(r, cfg4.Icon)
                rowLabel(r, cfg4.Title or "Segment", 11, x)

                local cellW = math.min(64, math.floor((132 - (#values - 1) * 2) / #values))
                local cw = cellW * #values + (#values - 1) * 2
                local control = new("Frame", {
                    Size = UDim2.fromOffset(cw, 26), Position = UDim2.new(1, -(cw + 12), 0.5, -13),
                    BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, BorderSizePixel = 0, ZIndex = 6,
                }, r)
                corner(control, 6)
                local indicator = new("Frame", {
                    Size = UDim2.fromOffset(cellW, 22), Position = UDim2.fromOffset(index == 1 and 2 or (2 + (index - 1) * (cellW + 2)), 2),
                    BackgroundColor3 = T.ACCENT, BorderSizePixel = 0, ZIndex = 7,
                }, control)
                corner(indicator, 5)
                local grad1 = grad(indicator, T.ACCENT, T.ACCENT_GLOW, 0)

                local cells = {}
                for i, v in ipairs(values) do
                    local cell = new("TextButton", {
                        Size = UDim2.fromOffset(cellW, 26), Position = UDim2.fromOffset(2 + (i - 1) * (cellW + 2), 0),
                        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 9,
                    }, control)
                    local lbl = new("TextLabel", {
                        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = tostring(v),
                        TextColor3 = T.TEXT_SEC, TextSize = 10, Font = Enum.Font.GothamBold, ZIndex = 10,
                        TextTruncate = Enum.TextTruncate.AtEnd,
                    }, cell)
                    table.insert(cells, {lbl = lbl, value = v, index = i})
                    on(cell.MouseButton1Click, function()
                        index = i
                        for _, c in ipairs(cells) do
                            c.lbl.TextColor3 = (c.index == index) and T.WHITE or T.TEXT_SEC
                        end
                        if perf then
                            indicator.Position = UDim2.fromOffset(2 + (index - 1) * (cellW + 2), 2)
                        else
                            tw(indicator, {Position = UDim2.fromOffset(2 + (index - 1) * (cellW + 2), 2)}, 0.18, Enum.EasingStyle.Quart)
                        end
                        if cfg4.Flag then Window.Flags[cfg4.Flag] = values[index] end
                        if Window._scheduleAutosave then Window._scheduleAutosave() end
                        pcall(cb, values[index])
                    end)
                end
                for _, c in ipairs(cells) do
                    c.lbl.TextColor3 = (c.index == index) and T.WHITE or T.TEXT_SEC
                end

                local Segment = {}
                local function set(v, silent)
                    for i, val in ipairs(values) do
                        if val == v or i == v then index = i end
                    end
                    indicator.Position = UDim2.fromOffset(2 + (index - 1) * (cellW + 2), 2)
                    for _, c in ipairs(cells) do
                        c.lbl.TextColor3 = (c.index == index) and T.WHITE or T.TEXT_SEC
                    end
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = values[index] end
                    if not silent then pcall(cb, values[index]) end
                end
                entry.set = function(v) set(v) end
                entry.get = function() return values[index] end
                entry.reset = function(silent) set(cfg4.Default or values[1], silent) end
                reg(entry, entry.set, entry.get, entry.reset)
                function Segment:Set(v) set(v) end
                function Segment:Get() return values[index] end
                function Segment:SetValue(v) set(v, true) end
                function Segment:Reset() entry.reset() end
                function Segment:GetIndex() return index end
                Segment.Row = r
                R(function(T2)
                    control.BackgroundColor3 = T2.PANEL
                    control.BackgroundTransparency = T2.ALPHA
                    indicator.BackgroundColor3 = T2.ACCENT
                    grad1.Color = ColorSequence.new(T2.ACCENT, T2.ACCENT_GLOW)
                    for _, c in ipairs(cells) do
                        c.lbl.TextColor3 = (c.index == index) and T2.WHITE or T2.TEXT_SEC
                    end
                end)
                return Segment
            end

            --========================= STEPPER ==========================
            function Section:Stepper(cfg4)
                cfg4 = cfg4 or {}
                local min = cfg4.Min or 0
                local max = cfg4.Max or 100
                local step = cfg4.Step or 1
                local value = math.clamp(cfg4.Default or min, min, max)
                local cb = cfg4.Callback or function() end

                local r, entry = buildRow(38, cfg4.Title or "Number", {flag = cfg4.Flag, extra = "number"})
                local x = iconSlot(r, cfg4.Icon)
                rowLabel(r, cfg4.Title or "Number", 11, x)

                local function mkBtn(glyph, xOff)
                    local b = new("TextButton", {
                        Size = UDim2.fromOffset(22, 22), Position = UDim2.new(1, xOff, 0.5, -11),
                        BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, Text = "",
                        AutoButtonColor = false, BorderSizePixel = 0, ZIndex = 6,
                    }, r)
                    corner(b, 5)
                    local g = makeGlyph(glyph, b, 9, T.TEXT_SEC)
                    g.Position = UDim2.fromOffset(11, 11)
                    hover(b, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.PANEL})
                    return b
                end
                local minus = mkBtn("minus", -102)
                local plus = mkBtn("plus", -12)
                local box = new("TextBox", {
                    Size = UDim2.fromOffset(52, 22), Position = UDim2.new(1, -78, 0.5, -11),
                    BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, Text = tostring(value),
                    TextColor3 = T.TEXT_PRI, TextSize = 10, Font = Enum.Font.GothamBold,
                    ClearTextOnFocus = false, BorderSizePixel = 0, ZIndex = 6,
                }, r)
                corner(box, 5)
                local bs = stroke(box, T.BORDER, 1, 0.5)

                local Stepper = {}
                local function set(v, silent)
                    v = math.clamp(tonumber(v) or min, min, max)
                    if step > 0 then v = math.floor((v - min) / step + 0.5) * step + min end
                    v = math.clamp(v, min, max)
                    value = v
                    box.Text = tostring(v)
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = v end
                    if Window._scheduleAutosave and not silent then Window._scheduleAutosave() end
                    if not silent then pcall(cb, v) end
                end
                on(minus.MouseButton1Click, function() set(value - step) end)
                on(plus.MouseButton1Click, function() set(value + step) end)
                on(box.FocusLost, function(enter)
                    local v = tonumber(box.Text)
                    if v then set(v) else box.Text = tostring(value) end
                end)
                entry.set = function(v) set(v) end
                entry.get = function() return value end
                entry.reset = function(silent) set(cfg4.Default or min, silent) end
                reg(entry, entry.set, entry.get, entry.reset)
                function Stepper:Set(v) set(v) end
                function Stepper:Get() return value end
                function Stepper:SetValue(v) set(v, true) end
                function Stepper:Reset() entry.reset() end
                Stepper.Row = r
                R(function(T2)
                    box.BackgroundColor3 = T2.PANEL
                    box.BackgroundTransparency = T2.ALPHA
                    box.TextColor3 = T2.TEXT_PRI
                    bs.Color = T2.BORDER
                end)
                return Stepper
            end

            --======================== PROGRESS ==========================
            function Section:Progress(cfg4)
                cfg4 = cfg4 or {}
                local min = cfg4.Min or 0
                local max = cfg4.Max or 100
                local value = cfg4.Default or min
                local suffix = cfg4.Suffix or ""

                local r, entry = buildRow(36, cfg4.Title or "Progress", {extra = "bar"})
                local lbl = rowLabel(r, cfg4.Title or "Progress", 6, 12)
                local percent = new("TextLabel", {
                    Size = UDim2.new(0, 60, 0, 12), Position = UDim2.new(1, -72, 0, 7), BackgroundTransparency = 1,
                    Text = "", TextColor3 = T.TEXT_MUTED, TextSize = 9, Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6,
                }, r)
                local track = new("Frame", {
                    Size = UDim2.new(1, -24, 0, 5), Position = UDim2.new(0, 12, 0, 24),
                    BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, BorderSizePixel = 0, ZIndex = 6,
                }, r)
                corner(track, 3)
                local fill = new("Frame", {
                    Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.ACCENT, BorderSizePixel = 0, ZIndex = 7,
                }, track)
                corner(fill, 3)
                local fg = grad(fill, T.ACCENT, T.ACCENT_GLOW, 0)

                local Progress = {}
                local function paint(instant)
                    local rel = (max - min == 0) and 0 or math.clamp((value - min) / (max - min), 0, 1)
                    local size = UDim2.new(rel, 0, 1, 0)
                    if perf or instant then
                        fill.Size = size
                    else
                        tw(fill, {Size = size}, 0.22, Enum.EasingStyle.Quart)
                    end
                    percent.Text = tostring(math.floor(rel * 100 + 0.5)) .. "%" .. suffix
                    lbl.Text = (cfg4.Title or "Progress") .. (cfg4.ShowValue and ("  " .. tostring(value)) or "")
                end
                function Progress:Set(v, inst)
                    value = math.clamp(tonumber(v) or 0, min, max)
                    paint(inst)
                    pcall(cfg4.Callback or function() end, value)
                end
                function Progress:Get() return value end
                function Progress:SetLabel(t) cfg4.Title = t; paint(true) end
                Progress.Row = r
                R(function(T2)
                    track.BackgroundColor3 = T2.PANEL
                    track.BackgroundTransparency = T2.ALPHA
                    fill.BackgroundColor3 = T2.ACCENT
                    fg.Color = ColorSequence.new(T2.ACCENT, T2.ACCENT_GLOW)
                    percent.TextColor3 = T2.TEXT_MUTED
                end)
                paint(true)
                return Progress
            end

            --==================== CHECKBOXES / RADIO ====================
            local function makeChooser(cfg4, single)
                cfg4 = cfg4 or {}
                local options = cfg4.Values or cfg4.Options or {"Option 1", "Option 2"}
                local cb = cfg4.Callback or function() end
                local selected
                if single then
                    selected = cfg4.Default or cfg4.Value or options[1]
                else
                    selected = cfg4.Default or cfg4.Value or {}
                    if type(selected) ~= "table" then selected = {selected} end
                end

                local headH = 22
                local rowH = #options * 24 + headH + 6
                local r, entry = buildRow(rowH, cfg4.Title or "Options", {flag = cfg4.Flag, extra = table.concat(options, " ")})
                rowLabel(r, cfg4.Title or "Options", 6, 12)

                local rows = {}
                local function isOn(v)
                    if single then return selected == v end
                    for _, s in ipairs(selected) do
                        if s == v then return true end
                    end
                    return false
                end
                local function refresh()
                    for _, o in ipairs(rows) do
                        local on = isOn(o.value)
                        o.box.BackgroundColor3 = on and T.ACCENT or T.PANEL
                        o.box.BackgroundTransparency = on and 0 or T.ALPHA
                        o.mark.Visible = on
                        o.lbl.TextColor3 = on and T.TEXT_PRI or T.TEXT_SEC
                    end
                end
                local function set(v, silent)
                    if single then
                        selected = v
                    else
                        selected = v or {}
                        if type(selected) ~= "table" then selected = {selected} end
                    end
                    refresh()
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = selected end
                    if Window._scheduleAutosave and not silent then Window._scheduleAutosave() end
                    if not silent then pcall(cb, selected) end
                end
                for i, opt in ipairs(options) do
                    local y = headH + (i - 1) * 24
                    local row = new("TextButton", {
                        Size = UDim2.new(1, -20, 0, 22), Position = UDim2.fromOffset(12, y),
                        BackgroundTransparency = 1, Text = "", AutoButtonColor = false, ZIndex = 6,
                    }, r)
                    local box = new("Frame", {
                        Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(0, 4),
                        BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, BorderSizePixel = 0, ZIndex = 7,
                    }, row)
                    corner(box, single and 7 or 4)
                    local mark = makeGlyph("check", box, 8, T.WHITE)
                    mark.Position = UDim2.fromOffset(7, 7)
                    mark.Visible = false
                    local lbl = new("TextLabel", {
                        Size = UDim2.new(1, -24, 1, 0), Position = UDim2.fromOffset(22, 0), BackgroundTransparency = 1,
                        Text = tostring(opt), TextColor3 = T.TEXT_SEC, TextSize = 10, Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7,
                    }, row)
                    table.insert(rows, {value = opt, box = box, mark = mark, lbl = lbl, row = row})
                    hover(row, {BackgroundTransparency = 0, BackgroundColor3 = T.CARD_HOVER}, {BackgroundTransparency = 1})
                    on(row.MouseButton1Click, function()
                        if single then
                            set(opt)
                        else
                            local idx
                            for i2, s in ipairs(selected) do
                                if s == opt then idx = i2 end
                            end
                            if idx then table.remove(selected, idx) else table.insert(selected, opt) end
                            refresh()
                            if cfg4.Flag then Window.Flags[cfg4.Flag] = selected end
                            if Window._scheduleAutosave then Window._scheduleAutosave() end
                            pcall(cb, selected)
                        end
                    end)
                end

                local Chooser = {}
                entry.set = function(v) set(v) end
                entry.get = function() return selected end
                entry.reset = function(silent) set(cfg4.Default or cfg4.Value or (single and options[1] or {}), silent) end
                reg(entry, entry.set, entry.get, entry.reset)
                function Chooser:Set(v) set(v) end
                function Chooser:Get() return selected end
                function Chooser:SetValue(v) set(v, true) end
                function Chooser:Reset() entry.reset() end
                function Chooser:IsOn(v) return isOn(v) end
                function Chooser:Toggle(v)
                    if single then
                        set(v)
                    else
                        local idx
                        for i, s in ipairs(selected) do
                            if s == v then idx = i end
                        end
                        if idx then table.remove(selected, idx) else table.insert(selected, v) end
                        refresh()
                    end
                end
                Chooser.Row = r
                R(function(T2)
                    for _, o in ipairs(rows) do
                        local on = isOn(o.value)
                        o.box.BackgroundColor3 = on and T2.ACCENT or T2.PANEL
                        o.box.BackgroundTransparency = on and 0 or T2.ALPHA
                        o.lbl.TextColor3 = on and T2.TEXT_PRI or T2.TEXT_SEC
                        setIconColor(o.mark, T2.WHITE)
                    end
                end)
                refresh()
                return Chooser
            end

            function Section:Checkboxes(cfg4) return makeChooser(cfg4, false) end
            function Section:Radio(cfg4) return makeChooser(cfg4, true) end

            --======================= PARAGRAPH ==========================
            function Section:Paragraph(cfg4)
                cfg4 = cfg4 or {}
                local desc = cfg4.Desc or ""
                local lines = math.max(1, math.ceil(#desc / 40))
                local hgt = (desc == "") and 34 or (24 + lines * 12)

                local r = buildRow(hgt, cfg4.Title or "Info", {extra = desc})
                local x = iconSlot(r, cfg4.Icon, 6)
                rowLabel(r, cfg4.Title or "Info", 6, x)
                if desc ~= "" then
                    local d = new("TextLabel", {
                        Size = UDim2.new(1, -20 - (x - 12), 0, lines * 12), Position = UDim2.new(0, x, 0, 22),
                        BackgroundTransparency = 1, Text = desc, TextColor3 = T.TEXT_MUTED, TextSize = 9,
                        Font = Enum.Font.Gotham, TextXAlignment = Enum.TextXAlignment.Left,
                        TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, ZIndex = 6,
                    }, r)
                    R(function(T2) d.TextColor3 = T2.TEXT_MUTED end)
                end
                return r
            end

            function Section:Label(text, desc)
                local r = buildRow(desc and 34 or 22, text or "")
                local l = new("TextLabel", {
                    Size = UDim2.new(1, -20, 0, 12), Position = UDim2.new(0, 12, 0, 5), BackgroundTransparency = 1,
                    Text = text or "", TextColor3 = T.TEXT_SEC, TextSize = 9, Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
                }, r)
                R(function(T2) l.TextColor3 = T2.TEXT_SEC end)
                if desc then
                    local d = new("TextLabel", {
                        Size = UDim2.new(1, -20, 0, 12), Position = UDim2.new(0, 12, 0, 18), BackgroundTransparency = 1,
                        Text = desc, TextColor3 = T.TEXT_MUTED, TextSize = 9, Font = Enum.Font.Gotham,
                        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 6,
                    }, r)
                    R(function(T2) d.TextColor3 = T2.TEXT_MUTED end)
                end
                return r
            end

            function Section:Divider()
                if grouped then
                    local r = buildRow(9, "divider")
                    r.BackgroundTransparency = 1
                    return r
                end
                local line = new("Frame", {
                    Size = UDim2.new(1, -8, 0, 1), BackgroundColor3 = T.BORDER,
                    BackgroundTransparency = 0.45, BorderSizePixel = 0, ZIndex = 4,
                }, page)
                R(function(T2) line.BackgroundColor3 = T2.BORDER end)
                return line
            end

            table.insert(Tab.Sections, Section)
            return Section
        end

        if #Window.Tabs == 1 then Tab:Select() end
        return Tab
    end

    function Window:SelectTab(name)
        if type(name) == "number" then
            local t = Window.Tabs[name]
            if t then t:Select() return true end
        elseif tabsIndex[name] then
            tabsIndex[name]:Select()
            return true
        end
        return false
    end

    function Window:Destroy()
        if Window.Unloaded then return end
        Window.Unloaded = true
        for _, fn in ipairs(unloadHooks) do pcall(fn) end
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        conns = {}
        pcall(function() tooltip:Destroy() end)
        if notifHolder then
            for _, n in ipairs(notifHolder:GetChildren()) do
                if n:IsA("Frame") then n:Destroy() end
            end
        end
        for flag in pairs(registry) do registry[flag] = nil end
        pcall(function() scr:Destroy() end)
        if _G.UglyHubWindow == Window then
            _G.UglyHubWindow = nil
            _G.UglyHubFlags = nil
            _G.UglyHubCleanup = nil
        end
    end
    function Window:Unload() Window:Destroy() end
    function Window:IsLoaded() return not Window.Unloaded and scr.Parent ~= nil end

    _G.UglyHubWindow = Window
    _G.UglyHubCleanup = function() Window:Destroy() end
    return Window
end

