            shadow.Position = main.Position - UDim2.fromOffset(2, -1)
        end
        sync()
        if time then
            local frames = 0
            local c
            c = RUN.RenderStepped:Connect(function()
                frames = frames + 1
                sync()
                if frames > time * 60 + 4 then
                    if c then c:Disconnect() end
                end
            end)
            track(c)
        end
    end

    on(header.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            local m = UIS:GetMouseLocation()
            dragStart = Vector2.new(m.X, m.Y)
            dragFrom = main.AbsolutePosition
        end
    end)
    on(UIS.InputChanged, function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local m = UIS:GetMouseLocation()
        if dragging and dragFrom then
            local delta = Vector2.new(m.X - dragStart.X, m.Y - dragStart.Y)
            local vp, sz = CAM.ViewportSize, main.AbsoluteSize
            local nx = math.clamp(dragFrom.X + delta.X, 0, math.max(0, vp.X - sz.X))
            local ny = math.clamp(dragFrom.Y + delta.Y, 0, math.max(0, vp.Y - sz.Y))
            -- magnetic edge snapping
            if nx < 14 then nx = 0 elseif nx > vp.X - sz.X - 14 then nx = vp.X - sz.X end
            if ny < 14 then ny = 0 elseif ny > vp.Y - sz.Y - 14 then ny = vp.Y - sz.Y end
