    local function refreshSearch(q)
        q = string.lower(q or "")
        local matches = 0
        if q == "" then
            for _, e in ipairs(entries) do
                e.row.Visible = true
            end
            for _, t in ipairs(Window.Tabs) do
                t:_refreshSearch()
            end
            searchCount.Visible = false
            searchClear.Visible = false
            return
        end
        for _, e in ipairs(entries) do
            local hit = string.find(string.lower(e.title or ""), q, 1, true) ~= nil
            e.row.Visible = hit
            if hit then matches = matches + 1 end
        end
        for _, t in ipairs(Window.Tabs) do
            t:_refreshSearch()
        end
        searchCount.Text = tostring(matches)
        searchCount.Visible = true
        searchClear.Visible = true
        -- jump to the first tab that has a hit
        for _, t in ipairs(Window.Tabs) do
            if t._visibleCount > 0 then
                t:Select()
                break
            end
        end
    end

