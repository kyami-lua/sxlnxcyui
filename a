local function palette(accent)
    local a = Azura.Accents[accent] or Azura.Accents.Purple
    return {
        Base    = Color3.fromRGB(11, 11, 14),
        Panel   = Color3.fromRGB(17, 17, 22),
        Card    = Color3.fromRGB(23, 23, 29),
        Row     = Color3.fromRGB(29, 29, 37),
        RowHi   = Color3.fromRGB(38, 38, 48),
        Sunk    = Color3.fromRGB(20, 20, 26),
        Line    = Color3.fromRGB(46, 46, 58),
        Text    = Color3.fromRGB(238, 238, 247),
        Text2   = Color3.fromRGB(158, 158, 175),
        Text3   = Color3.fromRGB(106, 106, 124),
        Good    = Color3.fromRGB(58, 205, 130),
        Bad     = Color3.fromRGB(240, 78, 92),
        Warn    = Color3.fromRGB(245, 190, 70),
        Accent  = a[1],
        Accent2 = a[2],
    }
end

--====================================== HELPERS =====================================
local function new(class, props, parent)
    local o = Instance.new(class)
    if props then
        for k, v in pairs(props) do
            o[k] = v
        end
    end
    if parent then o.Parent = parent end
    return o
end

local function corner(o, r)
    return new("UICorner", {CornerRadius = UDim.new(0, r or 8)}, o)
end

local function stroke(o, color, thickness, transparency)
    return new("UIStroke", {
        Color = color,
        Thickness = thickness or 1,
        Transparency = transparency or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, o)
end

local function padding(o, top, right, bottom, left)
    return new("UIPadding", {
        PaddingTop = UDim.new(0, top or 0),
        PaddingRight = UDim.new(0, right or 0),
        PaddingBottom = UDim.new(0, bottom or 0),
        PaddingLeft = UDim.new(0, left or 0),
    }, o)
end

local function list(o, gap, dir)
    return new("UIListLayout", {
        Padding = UDim.new(0, gap or 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        FillDirection = dir or Enum.FillDirection.Vertical,
    }, o)
end

local function grad(o, c1, c2, rot)
    return new("UIGradient", {
        Color = ColorSequence.new(c1, c2),
        Rotation = rot or 0,
    }, o)
end

local function tween(o, props, time, style, dir)
    local t = TS:Create(o, TweenInfo.new(time or 0.18, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function hover(obj, base, hi, speed)
    obj.MouseEnter:Connect(function()
        tween(obj, {BackgroundColor3 = hi}, speed or 0.14)
    end)
    obj.MouseLeave:Connect(function()
        tween(obj, {BackgroundColor3 = base}, speed or 0.14)
    end)
end

-- icon = "rbxassetid://123"  ->  ImageLabel        |      icon = "◆" -> glyph label
local function iconBox(parent, size, icon, color)
    if type(icon) == "string" and icon:find("rbxassetid") then
        return new("ImageLabel", {
            Size = UDim2.fromOffset(size, size),
            BackgroundTransparency = 1,
            Image = icon,
            ImageColor3 = color,
            ScaleType = Enum.ScaleType.Fit,
        }, parent)
    end
    return new("TextLabel", {
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = 1,
        Text = icon or "◆",
        TextColor3 = color,
        TextSize = math.max(10, size - 6),
        Font = Enum.Font.GothamBold,
    }, parent)
end

local function iconColor(o, c)
    if o:IsA("TextLabel") then
        o.TextColor3 = c
    else
        o.ImageColor3 = c
    end
end

local function safeParent()
    local ok, hui = pcall(function()
        if gethui then return gethui() end
        return game:GetService("CoreGui")
    end)
    if ok and hui then return hui end
    local ok2, pg = pcall(function() return PLR:WaitForChild("PlayerGui", 5) end)
    return ok2 and pg or PLR.PlayerGui
end

