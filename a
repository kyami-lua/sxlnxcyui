            --========================== SLIDER ==========================
            function Section:Slider(cfg4)
                cfg4 = cfg4 or {}
                local min = (cfg4.Value and cfg4.Value.Min) or cfg4.Min or 0
                local max = (cfg4.Value and cfg4.Value.Max) or cfg4.Max or 100
                local value = (cfg4.Value and cfg4.Value.Default) or cfg4.Default or min
                local step = cfg4.Step or 1
                local suffixes = cfg4.Suffix or ""
                local cb = cfg4.Callback or function() end

                local r = buildRow(52, cfg4.Title or "Slider")
                local x = iconSlot(r, cfg4.Icon, 7)
                local lbl = rowLabel(r, (cfg4.Title or "Slider") .. ": " .. tostring(value) .. suffixes, 7, x)
                local percent = new("TextLabel", {
                    Size = UDim2.new(0, 40, 0, 12),
                    Position = UDim2.new(1, -50, 0, 8),
                    BackgroundTransparency = 1,
                    Text = "",
                    TextColor3 = T.TEXT_MUTED,
                    TextSize = 9,
                    Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    ZIndex = 6,
                }, r)

                local track = new("Frame", {
                    Size = UDim2.new(1, -20, 0, 6),
                    Position = UDim2.new(0, 10, 0, 34),
                    BackgroundColor3 = T.PANEL,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                }, r)
                corner(track, 3)
                local fill = new("Frame", {
                    Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
                    BackgroundColor3 = T.ACCENT,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }, track)
                corner(fill, 3)
                local hit = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0.5, -11),
                    BackgroundTransparency = 1,
                    Text = "",
                    ZIndex = 9,
                }, track)

                local Slider = {}
                local sliding = false

                local function fmt(v)
                    if step % 1 ~= 0 then return string.format("%.2f", v) end
                    return tostring(math.floor(v + 0.5))
                end

                local function set(v, silent)
                    v = math.clamp(tonumber(v) or min, min, max)
                    if step > 0 then
                        v = math.floor((v - min) / step + 0.5) * step + min
                        v = math.clamp(v, min, max)
                    end
                    value = v
                    local rel = (max - min == 0) and 0 or (v - min) / (max - min)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    lbl.Text = (cfg4.Title or "Slider") .. ": " .. fmt(v) .. suffixes
                    percent.Text = tostring(math.floor(rel * 100 + 0.5)) .. "%"
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = v end
                    if not silent then pcall(cb, v) end
                end

                local function fromX(x2)
                    local rel = math.clamp((x2 - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    set(min + (max - min) * rel)
                end

                hit.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = true
                        fromX(input.Position.X)
                    end
                end)
                UIS.InputChanged:Connect(function(input)
                    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then
                        fromX(input.Position.X)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
                end)

                function Slider:Set(v) set(v) end
                function Slider:Get() return value end
                function Slider:SetValue(v) set(v, true) end
                if cfg4.Flag then setters[cfg4.Flag] = function(v) set(v) end end
                set(value, true)
                return Slider
            end

