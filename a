local function EnhanceWindow(win)
    win = applyWindowExtras(win)
    local origTab = win.Tab
    win.Tab = function(self, cfg2)
        local tab = origTab(self, cfg2)
        local origSection = tab.Section
        tab.Section = function(self, cfg3)
            local sec = origSection(self, cfg3)
            return hardenSection(sec)
        end
        return tab
    end
    return win
end

function Ugly:CreateWindow(cfg4)
    local win = Azura:CreateWindow(cfg4)
    return EnhanceWindow(win)
end

