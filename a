            local function reg(entry, setter, getter, resetter, default)
                entry.set = setter
                entry.get = getter
                entry.reset = resetter
                entry.default = default
                Window:_registerElement(entry)
                return entry
            end

            --========================== TOGGLE ==========================
            function Section:Toggle(cfg4)
                cfg4 = cfg4 or {}
                local desc = cfg4.Desc or ""
                local state = cfg4.Default and true or false
                local cb = cfg4.Callback or function() end
                local h = desc ~= "" and 44 or 36

                local r, entry = buildRow(h, cfg4.Title or "Toggle", {flag = cfg4.Flag, extra = desc})
                local x = iconSlot(r, cfg4.Icon, desc ~= "" and 8 or 11)
                local lbl = rowLabel(r, cfg4.Title or "Toggle", desc ~= "" and 8 or 11, x)
                if desc ~= "" then rowDesc(r, desc, 25, x) end

                local halo = new("Frame", {
                    Size = UDim2.fromOffset(42, 26), Position = UDim2.new(1, -49, 0.5, -13),
                    BackgroundColor3 = T.ACCENT, BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5,
                }, r)
                corner(halo, 13)

                local track = new("TextButton", {
                    Size = UDim2.new(0, 36, 0, 20), Position = UDim2.new(1, -46, 0.5, -10),
                    BackgroundColor3 = state and T.ACCENT or T.BORDER, BorderSizePixel = 0, Text = "",
                    AutoButtonColor = false, ZIndex = 6,
                }, r)
                corner(track, 10)
                local knob = new("Frame", {
                    Size = UDim2.new(0, 14, 0, 14), BackgroundColor3 = T.WHITE, BorderSizePixel = 0, ZIndex = 7,
                    Position = state and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7),
                }, track)
                corner(knob, 7)

                local Toggle = {}
                local function paint(instant)
                    local on = state
                    track.BackgroundColor3 = on and T.ACCENT or T.BORDER
                    if perf or instant then
                        knob.Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)
                        halo.BackgroundTransparency = on and 0.86 or 1
                    else
                        tw(knob, {Position = on and UDim2.new(1, -17, 0.5, -7) or UDim2.new(0, 3, 0.5, -7)}, 0.18, Enum.EasingStyle.Back)
                        halo.BackgroundTransparency = on and 0.86 or 1
                    end
                end
                local function set(v, silent, instant)
                    state = v and true or false
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = state end
                    if Window._scheduleAutosave and not silent then Window._scheduleAutosave() end
                    paint(instant)
                    if not silent then pcall(cb, state) end
                end
                entry.set = function(v) set(v) end
                entry.get = function() return state end
                entry.reset = function(silent) set(cfg4.Default and true or false, silent, true) end
                entry.default = state
                reg(entry, entry.set, entry.get, entry.reset)
                function Toggle:Set(v) set(v) end
                function Toggle:Get() return state end
                function Toggle:SetValue(v) set(v, true, true) end
                function Toggle:Reset() entry.reset() end
                Toggle.Row = r
                on(track.MouseButton1Click, function() set(not state) end)
                R(function(T2)
                    track.BackgroundColor3 = state and T2.ACCENT or T2.BORDER
                    halo.BackgroundColor3 = T2.ACCENT
                    knob.BackgroundColor3 = T2.WHITE
                end)
                set(state, true, true)
                return Toggle
            end

            --========================== SLIDER ==========================
            function Section:Slider(cfg4)
                cfg4 = cfg4 or {}
                local min = (cfg4.Value and cfg4.Value.Min) or cfg4.Min or 0
                local max = (cfg4.Value and cfg4.Value.Max) or cfg4.Max or 100
                local value = (cfg4.Value and cfg4.Value.Default) or cfg4.Default or min
                local step = cfg4.Step or 1
                local suffix = cfg4.Suffix or ""
                local cb = cfg4.Callback or function() end

                local r, entry = buildRow(52, cfg4.Title or "Slider", {flag = cfg4.Flag, extra = tostring(min) .. " " .. tostring(max)})
                local x = iconSlot(r, cfg4.Icon, 7)
                local lbl = rowLabel(r, (cfg4.Title or "Slider") .. ": " .. tostring(value) .. suffix, 7, x)
                local percent = new("TextLabel", {
                    Size = UDim2.new(0, 44, 0, 12), Position = UDim2.new(1, -54, 0, 8), BackgroundTransparency = 1,
                    Text = "", TextColor3 = T.TEXT_MUTED, TextSize = 9, Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 6,
                }, r)

                local track = new("Frame", {
                    Size = UDim2.new(1, -24, 0, 6), Position = UDim2.new(0, 12, 0, 34),
                    BackgroundColor3 = T.PANEL, BackgroundTransparency = T.ALPHA, BorderSizePixel = 0, ZIndex = 6,
                }, r)
                corner(track, 3)
                local fill = new("Frame", {
                    Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = T.ACCENT, BorderSizePixel = 0, ZIndex = 7,
                }, track)
                corner(fill, 3)
                local thumb = new("Frame", {
                    Size = UDim2.fromOffset(11, 11), BackgroundColor3 = T.WHITE, BorderSizePixel = 0, ZIndex = 9,
                }, r)
                corner(thumb, 6)

                -- tick marks
                if step > 0 and (max - min) / step <= 24 and (max - min) / step > 1 then
                    local n = math.floor((max - min) / step)
                    for i = 0, n do
                        local t = new("Frame", {
                            Size = UDim2.fromOffset(1, 4), Position = UDim2.new((i * step) / (max - min), 0, 0.5, -2),
                            BackgroundColor3 = T.BORDER, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 5,
                        }, track)
                        R(function(T2) t.BackgroundColor3 = T2.BORDER end)
                    end
                end

                local hit = new("TextButton", {
                    Size = UDim2.new(1, -24, 0, 26), Position = UDim2.new(0, 12, 0, 24),
                    BackgroundTransparency = 1, Text = "", ZIndex = 10,
                }, r)

                local Slider = {}
                local sliding = false

                local function fmt(v)
                    if step % 1 ~= 0 then return string.format("%.2f", v) end
                    return tostring(math.floor(v + 0.5))
                end
                local function paint()
                    local rel = (max - min == 0) and 0 or math.clamp((value - min) / (max - min), 0, 1)
                    fill.Size = UDim2.new(rel, 0, 1, 0)
                    local tw2 = track.AbsoluteSize.X
                    thumb.Position = UDim2.new(0, 12 + tw2 * rel - 5.5, 0, 31.5)
                    lbl.Text = (cfg4.Title or "Slider") .. ": " .. fmt(value) .. suffix
                    percent.Text = tostring(math.floor(rel * 100 + 0.5)) .. "%"
                end
                local function set(v, silent)
                    v = math.clamp(tonumber(v) or min, min, max)
                    if step > 0 then
                        v = math.floor((v - min) / step + 0.5) * step + min
                        v = math.clamp(v, min, max)
                    end
                    value = v
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = v end
                    if Window._scheduleAutosave and not silent then Window._scheduleAutosave() end
                    paint()
                    if not silent then pcall(cb, v) end
                end
                local function fromX(px)
                    local rel = math.clamp((px - track.AbsolutePosition.X) / math.max(1, track.AbsoluteSize.X), 0, 1)
                    set(min + (max - min) * rel)
                end

                on(hit.InputBegan, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then
                        sliding = true
                        fromX(input.Position.X)
                        tw(thumb, {Size = UDim2.fromOffset(14, 14)}, 0.1)
                    end
                end)
                on(UIS.InputChanged, function(input)
                    if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then fromX(input.Position.X) end
                end)
                on(UIS.InputEnded, function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 and sliding then
                        sliding = false
                        paint()
                        tw(thumb, {Size = UDim2.fromOffset(11, 11)}, 0.12)
                    end
                end)

                entry.set = function(v) set(v) end
                entry.get = function() return value end
                entry.reset = function(silent) set((cfg4.Value and cfg4.Value.Default) or cfg4.Default or min, silent) end
                reg(entry, entry.set, entry.get, entry.reset)
                function Slider:Set(v) set(v) end
                function Slider:Get() return value end
                function Slider:SetValue(v) set(v, true) end
                function Slider:Reset() entry.reset() end
                Slider.Row = r
                R(function(T2)
                    track.BackgroundColor3 = T2.PANEL
                    fill.BackgroundColor3 = T2.ACCENT
                    thumb.BackgroundColor3 = T2.WHITE
                    percent.TextColor3 = T2.TEXT_MUTED
                end)
                set(value, true)
                return Slider
            end

            --======================== DROPDOWN ==========================
            function Section:Dropdown(cfg4)
                cfg4 = cfg4 or {}
                local options = cfg4.Values or cfg4.Options or {"Option 1", "Option 2"}
                local multi = cfg4.Multi and true or false
                local selected
                if multi then
                    selected = cfg4.Default or cfg4.Value or {}
                    if type(selected) ~= "table" then selected = {selected} end
                else
                    selected = cfg4.Default or cfg4.Value or options[1]
                end
                local cb = cfg4.Callback or function() end
                local maxVisible = math.min(#options, 8)
                local listH = maxVisible * 24 + 4
                local scrolls = #options > maxVisible

                local r, entry = buildRow(38, cfg4.Title or "Dropdown", {flag = cfg4.Flag, extra = table.concat(options, " ")})
                local x = iconSlot(r, cfg4.Icon)
                rowLabel(r, cfg4.Title or "Dropdown", 11, x)
                local valueLbl = new("TextLabel", {
                    Size = UDim2.new(0, 110, 0, 12), Position = UDim2.new(1, -58, 0, 12), BackgroundTransparency = 1,
                    Text = "", TextColor3 = T.ACCENT, TextSize = 10, Font = Enum.Font.GothamBold,
                    TextXAlignment = Enum.TextXAlignment.Right, TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 6,
                }, r)
