local animEntries = {}

local function registerAnim(holder, chars, T, speed, tint, c1, c2)
    local entry = {
        holder = holder, chars = chars,
        c1 = c1 or T.ACCENT, c2 = c2 or T.ACCENT_GLOW,
        speed = speed or 0.55, phase = math.random() * 6,
        tint = (tint ~= false),
    }
    table.insert(animEntries, entry)
    return entry
end

local function retintAnims(T)
    for _, e in ipairs(animEntries) do
        if e.tint then e.c1, e.c2 = T.ACCENT, T.ACCENT_GLOW end
    end
end

task.spawn(function()
    while true do
        local base = tick()
        for i = #animEntries, 1, -1 do
            local e = animEntries[i]
            if not e.holder.Parent then
                table.remove(animEntries, i)
            elseif not e.frozen and not Azura._perf then
                local n = #e.chars
                if n > 0 then
                    local offset = (base * e.speed + e.phase) % 1
                    for idx, lbl in ipairs(e.chars) do
                        local t = ((idx - 1) / n + offset) % 1
                        lbl.TextColor3 = lerpColor(e.c1, e.c2, 0.5 + 0.5 * math.sin(t * math.pi * 2))
                    end
                end
            end
        end
        task.wait(Azura._perf and 0.2 or 0.03)
    end
end)

local function animatedLabel(parent, text, charW, charH, textSize, font, T, speed, tint)
    local holder = new("Frame", {
        Size = UDim2.new(0, #text * charW, 0, charH),
        BackgroundTransparency = 1, ClipsDescendants = false,
    }, parent)
    local chars = {}
    for i = 1, #text do
        local lbl = new("TextLabel", {
            Size = UDim2.new(0, charW + 1, 0, charH),
            Position = UDim2.new(0, (i - 1) * charW, 0.5, -charH / 2),
            BackgroundTransparency = 1, Text = text:sub(i, i), TextColor3 = T.TEXT_SEC,
            Font = font or Enum.Font.GothamBold, TextSize = textSize or 12,
            TextXAlignment = Enum.TextXAlignment.Center,
        }, holder)
        table.insert(chars, lbl)
    end
    registerAnim(holder, chars, T, speed, tint)
    return holder, chars
end

local function staticize(chars, color)
    for _, c in ipairs(chars) do c.TextColor3 = color end
end

