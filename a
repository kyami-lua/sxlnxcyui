    local maxed, prevGeom = false, nil
    local function geom()
        return {size = main.Size, pos = main.Position}
    end
    local function applyGeom(size, position, time)
        prevGeom = nil
        local props = {Size = size, Position = position}
        if time then
            tw(main, props, time, Enum.EasingStyle.Quart)
        else
            main.Size, main.Position = size, position
        end
        local function sync()
            glow.Size = UDim2.new(0, main.Size.X.Offset + 12, 0, main.Size.Y.Offset + 12)
