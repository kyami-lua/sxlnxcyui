                    hover(row, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.PANEL})
                    on(row.MouseButton1Click, function()
                        if multi then
                            local idx
                            for i2, s in ipairs(selected) do
                                if s == opt then idx = i2 end
                            end
                            if idx then table.remove(selected, idx) else table.insert(selected, opt) end
                        else
                            selected = opt
                            close()
                        end
                        text()
                        refresh()
                        if cfg4.Flag then Window.Flags[cfg4.Flag] = selected end
                        if Window._scheduleAutosave then Window._scheduleAutosave() end
                        pcall(cb, selected)
                    end)
                    R(function(T2)
                        row.BackgroundColor3 = picked(opt) and T2.ACCENT_FADE or T2.PANEL
                        row.BackgroundTransparency = T2.ALPHA
                        lbl.TextColor3 = picked(opt) and T2.ACCENT or T2.TEXT_SEC
                        setIconColor(check, T2.ACCENT)
                    end)
                end
                refresh()
                text()

                on(head.MouseButton1Click, function()
                    if open then close() else expand() end
                    if open and scrolls then listParent.CanvasPosition = Vector2.new(0, 0) end
                end)

                local Dropdown = {}
                local function apply(v)
                    selected = v
                    if multi then
