-- returns bar, update(), repaint(T)
local function attachScrollbar(page, T)
    local bar = new("TextButton", {
        Size = UDim2.new(0, 5, 0, 0), Position = UDim2.new(1, -7, 0, 4),
        BackgroundColor3 = T.ACCENT, BackgroundTransparency = 0.15, BorderSizePixel = 0,
        Text = "", AutoButtonColor = false, Visible = false, ZIndex = 20,
    }, page)
    corner(bar, 3)

    local dragging, dragStart, canvasStart = false, 0, 0
    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = UIS:GetMouseLocation().Y
            canvasStart = page.CanvasPosition.Y
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if not dragging or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
        local ch, wh = page.CanvasSize.Y.Offset, page.AbsoluteWindowSize.Y
        if ch <= wh then return end
        local sbH = math.max((wh / ch) * wh, 22)
        local delta = UIS:GetMouseLocation().Y - dragStart
        local canvasDelta = delta / math.max(1, (wh - sbH)) * (ch - wh)
        page.CanvasPosition = Vector2.new(0, math.clamp(canvasStart + canvasDelta, 0, ch - wh))
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    bar.MouseEnter:Connect(function() bar.Size = UDim2.new(0, 8, 0, bar.Size.Y.Offset) end)
    bar.MouseLeave:Connect(function() bar.Size = UDim2.new(0, 5, 0, bar.Size.Y.Offset) end)

    local function update()
        if not page.Parent then return end
        local ch, wh = page.CanvasSize.Y.Offset, page.AbsoluteWindowSize.Y
        if ch <= wh then
            bar.Visible = false
            return
        end
        bar.Visible = true
        local sbH = math.max((wh / ch) * wh, 22)
        local sbY = (page.CanvasPosition.Y / (ch - wh)) * (wh - sbH)
        bar.Size = UDim2.new(0, bar.Size.X.Offset, 0, sbH)
        bar.Position = UDim2.new(1, -7, 0, sbY + 4)
    end

    local function repaint(T2) bar.BackgroundColor3 = T2.ACCENT end
    return bar, update, repaint
end

