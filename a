        btn.Size = UDim2.fromOffset(30, 30)
        btn.Position = UDim2.new(1, -40, 0, 90)
        btn.BackgroundColor3 = Color3.fromRGB(24, 24, 29)
        btn.Text = cfg4.Text or "🐸"
        btn.TextSize = 14
        btn.Font = Enum.Font.GothamBold
        btn.Parent = gui
        local cr = Instance.new("UICorner")
        cr.CornerRadius = UDim.new(0, 6)
        cr.Parent = btn
        btn.MouseButton1Click:Connect(function()
            win:SetVisible(not win.Visible)
        end)
        return btn
    end

    function win.IsLoaded()
        return (not win.Unloaded) and win.Gui.Parent ~= nil
    end

    -- Config/profile manager bound to a window
    function win.Config(cfg4)
        cfg4 = cfg4 or {}
        local base = cfg4.ConfigFile or "UglyHub"
        local profile = {}
        local current = nil

        function profile.CreateConfig(name)
            name = tostring(name):gsub("[^%w_%-]", "")
            if name == "" then return false end
            current = name
            return true
        end
        function profile.Set(name) current = name end
        function profile.DeleteConfig(name)
            name = tostring(name or current)
            if not name or name == "" then return false end
            return safe(function()
                local ok = pcall(function() delfile(base .. name .. ".json") end)
                return ok
            end) or false
        end
        function profile.AllConfigs()
            local out = {}
            pcall(function()
                if not listfiles then return end
                for _, f in ipairs(listfiles("")) do
                    local nm = tostring(f):match((base .. "(.+)%.json$"):gsub("%-", "%%-"))
                    if nm then table.insert(out, nm) end
                end
            end)
            return out
        end
        function profile.Save(name)
            name = tostring(name or current or "default")
            return win:SaveConfig(base .. name .. ".json")
        end
        function profile.Load(name)
            name = tostring(name or current or "default")
            local ok = win:LoadConfig(base .. name .. ".json")
            if ok then current = name end
            return ok
        end
        return profile
    end
    return win
end

