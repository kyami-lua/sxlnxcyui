            function Section:Slider(config)
                config = config or {}
                local sTitle = config.Title or "Slider"
                local sMin = config.Value and config.Value.Min or 0
                local sMax = config.Value and config.Value.Max or 100
                local sDefault = config.Value and config.Value.Default or 50
                local sCallback = config.Callback or function() end
                local sStep = config.Step or 1
                
                local sliderFrame = Instance.new("Frame")
