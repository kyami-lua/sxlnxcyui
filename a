                    if multi then
                        valueLbl.Text = (#selected == 0) and "None" or table.concat(selected, ", ")
                        valueLbl.TextColor3 = (#selected == 0) and T.TEXT_MUTED or T.ACCENT
                    else
                        valueLbl.Text = tostring(selected)
                        valueLbl.TextColor3 = T.ACCENT
                    end
                end
                local function picked(v)
                    if multi then
                        for _, s in ipairs(selected) do
                            if s == v then return true end
                        end
                        return false
                    end
                    return selected == v
                end
                local function refresh()
                    for _, o in ipairs(opts) do
                        local on = picked(o.value)
                        o.lbl.TextColor3 = on and T.ACCENT or T.TEXT_SEC
                        o.check.Visible = on
                        o.row.BackgroundColor3 = on and T.ACCENT_FADE or T.PANEL
                    end
