function Azura:Notify(cfg)
    cfg = cfg or {}
    local T = cfg.Theme or Azura._theme or palette("Purple")

    local holder = getNotifHolder()
    local card = new("Frame", {
        Size = UDim2.new(0, 300, 0, 0),
        BackgroundColor3 = T.Card,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Position = UDim2.new(0, 44, 0, 0),
    }, holder)
    corner(card, 9)
    stroke(card, T.Line, 1, 0.35)

    local bar = new("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    }, card)
    grad(bar, T.Accent, T.Accent2, 90)

    new("TextLabel", {
        Size = UDim2.new(1, -30, 0, 15),
        Position = UDim2.new(0, 14, 0, 10),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        TextColor3 = T.Text,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local body = new("TextLabel", {
        Size = UDim2.new(1, -28, 0, 0),
        Position = UDim2.new(0, 14, 0, 27),
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        TextColor3 = T.Text2,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, card)

    local prog = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = T.Accent,
        BorderSizePixel = 0,
    }, card)
    grad(prog, T.Accent, T.Accent2, 0)

    task.defer(function()
        local h = math.clamp(30 + body.TextBounds.Y + 12, 62, 190)
        tween(card, {Size = UDim2.new(0, 300, 0, h), Position = UDim2.new(0, 0, 0, 0)}, 0.34,
            Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    end)

    local dead = false
    local function kill()
        if dead then return end
        dead = true
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") then tween(d, {TextTransparency = 1}, 0.18) end
            if d:IsA("Frame") then tween(d, {BackgroundTransparency = 1}, 0.18) end
        end
        tween(card, {Position = UDim2.new(0, 44, 0, 0)}, 0.22).Completed:Connect(function()
            card:Destroy()
        end)
    end

    local duration = cfg.Duration or 4
    task.spawn(function()
        local steps = math.max(8, math.floor(duration * 25))
        for i = 1, steps do
            if dead or not card.Parent then return end
            prog.Size = UDim2.new(1 - (i / steps), 0, 0, 2)
            task.wait(math.max(0.02, duration / steps))
        end
        kill()
    end)

    return card
end

