                listLayout.Padding = UDim.new(0, 2)
                listLayout.Parent = dropdownList
                createPadding(dropdownList, 4, 4, 4, 4)
                
                local opened = false
                
                local function toggleDropdown()
                    opened = not opened
                    dropdownList.Visible = opened
                    if opened then
                        local count = #dValues
                        dropdownFrame.Size = UDim2.new(1, 0, 0, 50 + (count * 28) + 12)
                        dropdownList.Size = UDim2.new(1, -24, 0, count * 28 + 8)
                    else
                        dropdownFrame.Size = UDim2.new(1, 0, 0, 50)
                    end
                end
                
                for _, value in pairs(dValues) do
                    local optionBtn = Instance.new("TextButton")
                    optionBtn.Size = UDim2.new(1, 0, 0, 26)
                    optionBtn.BackgroundColor3 = theme.Background3
                    optionBtn.Text = tostring(value)
                    optionBtn.TextColor3 = theme.Text2
                    optionBtn.TextSize = 12
                    optionBtn.Font = Enum.Font.Gotham
                    optionBtn.Parent = dropdownList
                    createCorner(optionBtn, 6)
                    
                    optionBtn.MouseButton1Click:Connect(function()
                        dropdownBtn.Text = tostring(value) .. "  ▼"
                        toggleDropdown()
                        pcall(dCallback, value)
                    end)
                end
                
                dropdownBtn.MouseButton1Click:Connect(toggleDropdown)
                
                local Dropdown = {}
                function Dropdown:Set(val)
                    dropdownBtn.Text = tostring(val) .. "  ▼"
                    pcall(dCallback, val)
                end
                return Dropdown
            end
            
