local function makeIcon(parent, name, size, color)
    local holder = new("Frame", {
        Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
    }, parent)
    if type(name) == "string" and name:find("rbxassetid") then
        new("ImageLabel", {
            Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Image = name,
            ImageColor3 = color, ScaleType = Enum.ScaleType.Fit,
        }, holder)
        return holder
    end
    local fn = ICONS[name] or ICONS.grid
    fn(holder, color, size / 16)
    return holder
end

local function setIconColor(holder, color)
    for _, d in ipairs(holder:GetDescendants()) do
        if d:IsA("Frame") then d.BackgroundColor3 = color end
        if d:IsA("ImageLabel") then d.ImageColor3 = color end
        if d:IsA("UIStroke") then d.Color = color end
    end
end

local function makeChevron(parent, size, color)
    local holder = new("Frame", {
        Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
    }, parent)
    local u = size / 16
    rect(holder, 5*u, 7*u, 7*u, 1.5*u, color, 45, 0.7*u)
    rect(holder, 11*u, 7*u, 7*u, 1.5*u, color, -45, 0.7*u)
    return holder
end

local function makeGlyph(kind, parent, size, color)
    local holder = new("Frame", {
        Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
    }, parent)
    local u = size / 16
    if kind == "minus" then
        rect(holder, size/2, size/2, size * 0.62, 1.5, color, 0, 0)
    elseif kind == "plus" then
        rect(holder, size/2, size/2, size * 0.62, 1.5, color, 0, 0)
        rect(holder, size/2, size/2, 1.5, size * 0.62, color, 0, 0)
    elseif kind == "cross" then
        rect(holder, size/2, size/2, size * 0.65, 1.5, color, 45, 0)
        rect(holder, size/2, size/2, size * 0.65, 1.5, color, -45, 0)
    elseif kind == "check" then
        rect(holder, 4.6*u, 9.2*u, 4.6*u, 1.5*u, color, 45, 0.7*u)
        rect(holder, 9.8*u, 6.6*u, 9.4*u, 1.5*u, color, -45, 0.7*u)
    elseif kind == "search" then
        ring(holder, size * 0.42, size * 0.42, size * 0.55, 1.4, color)
        rect(holder, size * 0.75, size * 0.75, size * 0.34, 1.4, color, 45, 0)
    elseif kind == "chevron" then
        rect(holder, 5*u, 7*u, 7*u, 1.5*u, color, 45, 0.7*u)
        rect(holder, 11*u, 7*u, 7*u, 1.5*u, color, -45, 0.7*u)
    elseif kind == "caret" then
        rect(holder, 5*u, 10*u, 7*u, 1.5*u, color, -45, 0.7*u)
