            --======================== KEYBIND ===========================
            function Section:Keybind(cfg4)
                cfg4 = cfg4 or {}
                local key = cfg4.Value or "F"
                local cb = cfg4.Callback or function() end
                local pressed = cfg4.Pressed

                local r = buildRow(38, cfg4.Title or "Keybind")
                local x = iconSlot(r, cfg4.Icon)
                rowLabel(r, cfg4.Title or "Keybind", 11, x)

                local b = new("TextButton", {
                    Size = UDim2.new(0, 62, 0, 22),
                    Position = UDim2.new(1, -72, 0.5, -11),
                    BackgroundColor3 = T.PANEL,
                    Text = key,
                    TextColor3 = T.TEXT_SEC,
                    TextSize = 10,
                    Font = Enum.Font.GothamBold,
                    AutoButtonColor = false,
                    BorderSizePixel = 0,
                    ZIndex = 6,
                }, r)
                corner(b, 5)
                local bs = stroke(b, T.BORDER, 1, 0.5)

                local listening = false
                local conn

                local function stop()
                    listening = false
                    if conn then conn:Disconnect() ; conn = nil end
                    bs.Color = T.BORDER
                    bs.Transparency = 0.5
                    tw(b, {BackgroundColor3 = T.PANEL}, 0.12)
                end

                b.MouseButton1Click:Connect(function()
                    if listening then
                        stop()
                        b.Text = key
                        return
                    end
                    listening = true
                    b.Text = "..."
                    bs.Color = T.ACCENT
                    bs.Transparency = 0.1
                    tw(b, {BackgroundColor3 = T.CARD_HOVER}, 0.12)
                    conn = UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                        if input.KeyCode == Enum.KeyCode.Escape then
                            b.Text = key
                        elseif input.KeyCode == Enum.KeyCode.Backspace then
                            key = "None"
                            b.Text = key
                            if cfg4.Flag then Window.Flags[cfg4.Flag] = key end
                            pcall(cb, key)
                        else
                            key = input.KeyCode.Name
                            b.Text = key
                            if cfg4.Flag then Window.Flags[cfg4.Flag] = key end
                            pcall(cb, key)
                        end
                        stop()
                    end)
                end)

                if pressed then
                    UIS.InputBegan:Connect(function(input, gpe)
                        if gpe then return end
                        if input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode.Name == key then
                            pcall(pressed)
                        end
                    end)
                end

                local Keybind = {}
                function Keybind:Set(k)
                    key = k
                    b.Text = k
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = k end
                    pcall(cb, k)
                end
                function Keybind:Get() return key end
                function Keybind:SetValue(k)
                    key = k
                    b.Text = k
                end
                if cfg4.Flag then
                    Window.Flags[cfg4.Flag] = key
                    setters[cfg4.Flag] = function(v) Keybind:SetValue(v) end
                end
                return Keybind
            end

