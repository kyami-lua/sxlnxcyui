function Azura:Notify(cfg)
    cfg = cfg or {}
    local T = cfg.Theme or Azura._theme or palette("Red")
    local holder = getNotifHolder()

    local card = new("Frame", {
        Size = UDim2.new(0, 280, 0, 0),
        BackgroundColor3 = T.SURFACE,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Position = UDim2.new(0, 40, 0, 0),
    }, holder)
    corner(card, 7)
    stroke(card, T.ACCENT_DIM, 1, 0.35)

    local bar = new("Frame", {
        Size = UDim2.new(0, 3, 1, 0),
        BackgroundColor3 = T.ACCENT,
        BorderSizePixel = 0,
    }, card)
    grad(bar, T.ACCENT, T.ACCENT_GLOW, 90)

    new("TextLabel", {
        Size = UDim2.new(1, -28, 0, 14),
        Position = UDim2.new(0, 13, 0, 9),
        BackgroundTransparency = 1,
        Text = cfg.Title or "Notification",
        TextColor3 = T.TEXT_PRI,
        TextSize = 12,
        Font = Enum.Font.GothamBold,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, card)

    local body = new("TextLabel", {
        Size = UDim2.new(1, -26, 0, 0),
        Position = UDim2.new(0, 13, 0, 25),
        BackgroundTransparency = 1,
        Text = cfg.Content or "",
        TextColor3 = T.TEXT_SEC,
        TextSize = 11,
        Font = Enum.Font.Gotham,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        TextWrapped = true,
        AutomaticSize = Enum.AutomaticSize.Y,
    }, card)

    local prog = new("Frame", {
        Size = UDim2.new(1, 0, 0, 2),
        Position = UDim2.new(0, 0, 1, -2),
        BackgroundColor3 = T.ACCENT,
        BorderSizePixel = 0,
    }, card)
    grad(prog, T.ACCENT, T.ACCENT_GLOW, 0)

    task.defer(function()
        local h = math.clamp(28 + body.TextBounds.Y + 12, 58, 180)
        tw(card, {Size = UDim2.new(0, 280, 0, h), Position = UDim2.new(0, 0, 0, 0)}, 0.3,
            Enum.EasingStyle.Quart)
    end)

    local dead = false
    local function kill()
        if dead then return end
        dead = true
        for _, d in ipairs(card:GetDescendants()) do
            if d:IsA("TextLabel") then tw(d, {TextTransparency = 1}, 0.16) end
            if d:IsA("Frame") then tw(d, {BackgroundTransparency = 1}, 0.16) end
        end
        tw(card, {Position = UDim2.new(0, 40, 0, 0)}, 0.2).Completed:Connect(function() card:Destroy() end)
    end

    local duration = cfg.Duration or 4
    task.spawn(function()
        local steps = math.max(8, math.floor(duration * 25))
        for i = 1, steps do
            if dead or not card.Parent then return end
            prog.Size = UDim2.new(1 - (i / steps), 0, 0, 2)
            task.wait(math.max(0.02, duration / steps))
        end
        kill()
    end)

    return card
end

