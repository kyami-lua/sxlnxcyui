local function safe(fn, ...)
    local ok, res = pcall(fn, ...)
    return ok and res or nil
end

-- if a previous run exists, cancel its loops and destroy its window
do
    local prev = getgenv().UglyHub
    if prev then
        if prev.__win then pcall(function() prev.__win:Destroy() end) end
        if prev.__kill then for _, f in ipairs(prev.__kill) do pcall(f) end end
    end
    -- purge any stale hub GUIs left by older builds
    pcall(function()
        local roots = {}
        local ok1, h1 = pcall(function() return gethui and gethui() end)
        if ok1 and h1 then table.insert(roots, h1) end
        table.insert(roots, game:GetService("CoreGui"))
        local ok2, pg = pcall(function() return Players.LocalPlayer:FindFirstChild("PlayerGui") end)
        if not (ok2 and pg) then pg = Players.LocalPlayer.PlayerGui end
        table.insert(roots, pg)
        local seen = {}
        for _, root in ipairs(roots) do
            if root and not seen[root] then
                seen[root] = true
                for _, c in ipairs(root:GetChildren()) do
                    if c:IsA("ScreenGui") and tostring(c.Name):match("^UglyHub_UglyHub$") then
                        pcall(function() c:Destroy() end)
                    end
                end
            end
        end
    end)
end

local function shallowCopy(t)
    local o = {}
    for k, v in pairs(t or {}) do o[k] = v end
    return o
end

local function lerpColor3(a, b, t)
    t = math.clamp(t, 0, 1)
    return Color3.fromRGB(
        math.floor(a.R * 255 + (b.R - a.R) * 255 * t),
        math.floor(a.G * 255 + (b.G - a.G) * 255 * t),
        math.floor(a.B * 255 + (b.B - a.B) * 255 * t))
end
Ugly.Lerp = lerpColor3
Ugly.Color3 = Color3
Ugly.ColorSequence = ColorSequence

