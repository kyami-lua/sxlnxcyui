                    elseif type(v) == "table" then
                        selected = v[1]
                    end
                    text()
                    refresh()
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = selected end
                end
                entry.set = function(v) apply(v); pcall(cb, selected) end
                entry.get = function() return selected end
                entry.reset = function() apply(cfg4.Default or cfg4.Value or (multi and {} or options[1])) end
                reg(entry, entry.set, entry.get, entry.reset)
                function Dropdown:Set(v) entry.set(v) end
                function Dropdown:Get() return selected end
                function Dropdown:SetValue(v) apply(v) end
                function Dropdown:Reset() entry.reset() end
                function Dropdown:Open()
                    if not open then expand() end
                end
                function Dropdown:Close() close() end
                function Dropdown:IsOpen() return open end
                Dropdown.Row = r
                R(function(T2)
                    holder.BackgroundColor3 = T2.CARD
                    holder.BackgroundTransparency = T2.ALPHA
                    valueLbl.TextColor3 = (multi and #selected == 0) and T2.TEXT_MUTED or T2.ACCENT
                    setIconColor(chev, T2.TEXT_SEC)
                end)
                return Dropdown
            end

