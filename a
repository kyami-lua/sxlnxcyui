                local chev = makeChevron(r, 9, T.TEXT_SEC)
                chev.Position = UDim2.new(1, -12, 0.5, 0)

                local holder = new("Frame", {
                    Size = UDim2.new(1, 0, 0, 38),
                    BackgroundColor3 = T.CARD,
                    BorderSizePixel = 0,
                    ZIndex = 7,
                }, r)
                corner(holder, 5)
                hover(holder, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.CARD})

                local head = new("TextButton", {
                    Size = UDim2.new(1, 0, 0, 38),
                    BackgroundTransparency = 1,
                    Text = "",
                    AutoButtonColor = false,
                    ZIndex = 8,
                }, holder)

                local open = false
                local opts = {}

                local function text()
                    if multi then
                        valueLbl.Text = (#selected == 0) and "None" or table.concat(selected, ", ")
                    else
                        valueLbl.Text = tostring(selected)
                    end
                end

                local function picked(v)
                    if multi then
                        for _, s in ipairs(selected) do
                            if s == v then return true end
                        end
                        return false
                    end
                    return selected == v
                end

                local function buildOptions()
                    for _, o in ipairs(opts) do o.frame:Destroy() end
                    opts = {}
                    for i, opt in ipairs(options) do
                        local row = new("TextButton", {
                            Size = UDim2.new(1, 0, 0, 24),
                            Position = UDim2.new(0, 0, 0, 38 + (i - 1) * 24),
                            BackgroundColor3 = T.PANEL,
                            Text = "",
                            AutoButtonColor = false,
                            BorderSizePixel = 0,
                            ZIndex = 8,
                        }, holder)
                        local lbl = new("TextLabel", {
                            Size = UDim2.new(1, -34, 1, 0),
                            Position = UDim2.new(0, 10, 0, 0),
                            BackgroundTransparency = 1,
                            Text = tostring(opt),
                            TextColor3 = T.TEXT_SEC,
                            TextSize = 10,
                            Font = Enum.Font.Gotham,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            ZIndex = 9,
                        }, row)
                        local check = makeCheck(row, 9, T.ACCENT)
                        check.Position = UDim2.new(1, -14, 0.5, 0)
                        check.Visible = false
                        table.insert(opts, {frame = row, lbl = lbl, check = check, value = opt})

                        hover(row, {BackgroundColor3 = T.CARD_HOVER}, {BackgroundColor3 = T.PANEL})
                        row.MouseButton1Click:Connect(function()
                            if multi then
                                local idx
                                for i2, s in ipairs(selected) do
                                    if s == opt then idx = i2 end
                                end
                                if idx then
                                    table.remove(selected, idx)
                                else
                                    table.insert(selected, opt)
                                end
                            else
                                selected = opt
                                open = false
                                chev.Rotation = 0
                                holder.Size = UDim2.new(1, 0, 0, 38)
                                r.Size = UDim2.new(1, 0, 0, 38)
                            end
                            text()
                            for _, o in ipairs(opts) do
                                o.lbl.TextColor3 = picked(o.value) and T.ACCENT or T.TEXT_SEC
                                o.check.Visible = picked(o.value)
                            end
                            if cfg4.Flag then Window.Flags[cfg4.Flag] = selected end
                            pcall(cb, selected)
                        end)
                    end
                    for _, o in ipairs(opts) do
                        o.lbl.TextColor3 = picked(o.value) and T.ACCENT or T.TEXT_SEC
                        o.check.Visible = picked(o.value)
                    end
                end
                buildOptions()
                text()

                head.MouseButton1Click:Connect(function()
                    open = not open
                    chev.Rotation = open and 180 or 0
                    local h2 = 38 + (open and #options * 24 or 0)
                    tw(holder, {Size = UDim2.new(1, 0, 0, h2)}, 0.18, Enum.EasingStyle.Quart)
                    tw(r, {Size = UDim2.new(1, 0, 0, h2)}, 0.18, Enum.EasingStyle.Quart)
                    if Section.Grouped then Section._sizeCard() end
                end)

                local Dropdown = {}
                function Dropdown:Set(v)
                    selected = v
                    if multi and type(v) ~= "table" then selected = {v} end
                    text()
                    for _, o in ipairs(opts) do
                        o.lbl.TextColor3 = picked(o.value) and T.ACCENT or T.TEXT_SEC
                        o.check.Visible = picked(o.value)
                    end
                    if cfg4.Flag then Window.Flags[cfg4.Flag] = selected end
                    pcall(cb, selected)
                end
                function Dropdown:Get() return selected end
                function Dropdown:SetValue(v)
                    selected = v
                    if multi and type(v) ~= "table" then selected = {v} end
                    text()
                    for _, o in ipairs(opts) do
                        o.lbl.TextColor3 = picked(o.value) and T.ACCENT or T.TEXT_SEC
                        o.check.Visible = picked(o.value)
                    end
                end
                if cfg4.Flag then
                    Window.Flags[cfg4.Flag] = selected
                    setters[cfg4.Flag] = function(v) Dropdown:Set(v) end
                end
                return Dropdown
            end

